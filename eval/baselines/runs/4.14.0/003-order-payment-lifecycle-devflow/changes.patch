 // In-memory order repository and order operations.
 
 const orders = new Map();
+// Ids of orders with a payment in flight. Not a public status: while a charge is
+// outstanding the order still reads `pending`, but it cannot be paid or cancelled.
+const paying = new Set();
 let nextId = 1;
 
 class ValidationError extends Error {
@@ -12,6 +15,21 @@ class ValidationError extends Error {
   }
 }
 
+class OrderNotFoundError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'OrderNotFoundError';
+  }
+}
+
+// The order exists but is not in a state that allows the requested operation.
+class OrderStateError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'OrderStateError';
+  }
+}
+
 function createOrder({ amount }) {
   if (!Number.isInteger(amount) || amount <= 0) {
     throw new ValidationError('amount must be a positive integer');
@@ -26,4 +44,46 @@ function getOrder(id) {
   return order ? { ...order } : null;
 }
 
-module.exports = { createOrder, getOrder, ValidationError };
+// Returns the stored order if it can currently be paid or cancelled; throws
+// otherwise. Synchronous on purpose: callers use it as an atomic check-then-act.
+function claimPending(id) {
+  const order = orders.get(id);
+  if (!order) throw new OrderNotFoundError('order not found');
+  if (order.status !== 'pending') {
+    throw new OrderStateError(`order is ${order.status}, only pending orders can be changed`);
+  }
+  if (paying.has(id)) throw new OrderStateError('a payment for this order is already in progress');
+  return order;
+}
+
+function cancelOrder(id) {
+  const order = claimPending(id);
+  order.status = 'cancelled';
+  return { ...order };
+}
+
+// Charges the order's stored amount through `charge(orderId, amount)` and marks
+// it paid. The order is claimed before the (slow) charge is awaited, so a second
+// pay or a cancel arriving meanwhile is rejected instead of racing; it is marked
+// paid only once the charge succeeded, and released again on any failure.
+async function payOrder(id, charge) {
+  const order = claimPending(id);
+  paying.add(id);
+  try {
+    await charge(order.id, order.amount);
+    order.status = 'paid';
+  } finally {
+    paying.delete(id);
+  }
+  return { ...order };
+}
+
+module.exports = {
+  createOrder,
+  getOrder,
+  cancelOrder,
+  payOrder,
+  ValidationError,
+  OrderNotFoundError,
+  OrderStateError,
+};
