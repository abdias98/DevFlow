diff --git a/test/order-actions.test.js b/test/order-actions.test.js
new file mode 100644
index 0000000..c886974
--- /dev/null
+++ b/test/order-actions.test.js
@@ -0,0 +1,202 @@
+'use strict';
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { createServer } = require('../src/server');
+const orders = require('../src/orders');
+const { MAX_CHARGE } = require('../src/payments');
+
+let server;
+let baseUrl;
+
+before(async () => {
+  server = createServer();
+  await new Promise((resolve) => server.listen(0, resolve));
+  baseUrl = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => new Promise((resolve) => server.close(resolve)));
+
+async function request(method, path, body) {
+  const res = await fetch(baseUrl + path, {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const text = await res.text();
+  return { status: res.status, body: text ? JSON.parse(text) : null };
+}
+
+async function createOrder(amount) {
+  const res = await request('POST', '/orders', { amount });
+  assert.equal(res.status, 201);
+  return res.body;
+}
+
+async function chargesFor(orderId) {
+  const ledger = await request('GET', '/ledger');
+  return ledger.body.filter((entry) => entry.orderId === orderId);
+}
+
+// --- cancel -----------------------------------------------------------------
+
+test('POST /orders/:id/cancel cancels a pending order and returns it', async () => {
+  const order = await createOrder(250);
+  const res = await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, { ...order, status: 'cancelled' });
+  const reread = await request('GET', `/orders/${order.id}`);
+  assert.equal(reread.body.status, 'cancelled');
+});
+
+test('POST /orders/:id/cancel does not charge anything', async () => {
+  const order = await createOrder(250);
+  const res = await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal(res.status, 200);
+  assert.deepEqual(await chargesFor(order.id), []);
+});
+
+test('POST /orders/:id/cancel returns 404 for an unknown order', async () => {
+  const res = await request('POST', '/orders/does-not-exist/cancel');
+  assert.equal(res.status, 404);
+  assert.equal(res.body.error, 'order not found');
+});
+
+test('S8: cancelling twice succeeds once, then 409 and the order stays cancelled', async () => {
+  const order = await createOrder(250);
+  assert.equal((await request('POST', `/orders/${order.id}/cancel`)).status, 200);
+  const second = await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal(second.status, 409);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'cancelled');
+});
+
+// --- pay --------------------------------------------------------------------
+
+test('POST /orders/:id/pay charges the order amount once and marks it paid', async () => {
+  const order = await createOrder(250);
+  const res = await request('POST', `/orders/${order.id}/pay`);
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, { ...order, status: 'paid' });
+  const charges = await chargesFor(order.id);
+  assert.equal(charges.length, 1);
+  assert.equal(charges[0].amount, 250);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+});
+
+test('POST /orders/:id/pay charges the stored amount, not one from the request body', async () => {
+  const order = await createOrder(250);
+  const res = await request('POST', `/orders/${order.id}/pay`, { amount: 1 });
+  assert.equal(res.status, 200);
+  assert.deepEqual((await chargesFor(order.id)).map((c) => c.amount), [250]);
+});
+
+test('POST /orders/:id/pay returns 404 for an unknown order and charges nothing', async () => {
+  const before = (await request('GET', '/ledger')).body.length;
+  const res = await request('POST', '/orders/does-not-exist/pay');
+  assert.equal(res.status, 404);
+  assert.equal(res.body.error, 'order not found');
+  assert.equal((await request('GET', '/ledger')).body.length, before);
+});
+
+test('S1: paying twice sequentially charges once; the second call gets 409', async () => {
+  const order = await createOrder(120);
+  assert.equal((await request('POST', `/orders/${order.id}/pay`)).status, 200);
+  const second = await request('POST', `/orders/${order.id}/pay`);
+  assert.equal(second.status, 409);
+  assert.equal((await chargesFor(order.id)).length, 1);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+});
+
+test('S2: concurrent pay requests on one order charge exactly once', async () => {
+  const order = await createOrder(300);
+  const results = await Promise.all(
+    [1, 2, 3].map(() => request('POST', `/orders/${order.id}/pay`)),
+  );
+  const statuses = results.map((r) => r.status).sort();
+  assert.deepEqual(statuses, [200, 409, 409]);
+  assert.equal((await chargesFor(order.id)).length, 1);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+});
+
+test('S3: cancel while a payment is in flight is rejected and the order ends paid', async () => {
+  const order = orders.createOrder({ amount: 75 });
+  let finishCharge;
+  const charge = () => new Promise((resolve) => { finishCharge = resolve; });
+
+  const paying = orders.payOrder(order.id, charge); // charge is now in flight
+  assert.throws(() => orders.cancelOrder(order.id), orders.OrderStateError);
+  assert.equal(orders.getOrder(order.id).status, 'pending');
+
+  finishCharge({ chargeId: 'stub' });
+  assert.equal((await paying).status, 'paid');
+  assert.equal(orders.getOrder(order.id).status, 'paid');
+});
+
+test('S3: pay while a payment is in flight is rejected without a second charge', async () => {
+  const order = orders.createOrder({ amount: 75 });
+  let calls = 0;
+  let finishCharge;
+  const charge = () => { calls += 1; return new Promise((resolve) => { finishCharge = resolve; }); };
+
+  const first = orders.payOrder(order.id, charge);
+  await assert.rejects(orders.payOrder(order.id, charge), orders.OrderStateError);
+  finishCharge({});
+  await first;
+  assert.equal(calls, 1);
+});
+
+test('S3b: racing pay and cancel over HTTP leave status consistent with the ledger', async () => {
+  const order = await createOrder(60);
+  const [pay, cancel] = await Promise.all([
+    request('POST', `/orders/${order.id}/pay`),
+    request('POST', `/orders/${order.id}/cancel`),
+  ]);
+  const charges = await chargesFor(order.id);
+  const final = (await request('GET', `/orders/${order.id}`)).body.status;
+  assert.deepEqual([pay.status, cancel.status].sort(), [200, 409]);
+  if (pay.status === 200) {
+    assert.equal(final, 'paid');
+    assert.equal(charges.length, 1);
+  } else {
+    assert.equal(final, 'cancelled');
+    assert.equal(charges.length, 0);
+  }
+});
+
+test('S4: a declined payment returns 402, leaves the order pending and the ledger untouched', async () => {
+  const order = await createOrder(MAX_CHARGE + 1);
+  const res = await request('POST', `/orders/${order.id}/pay`);
+  assert.equal(res.status, 402);
+  assert.equal(typeof res.body.error, 'string');
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'pending');
+  assert.deepEqual(await chargesFor(order.id), []);
+  // the order is not stuck: it can still be cancelled
+  assert.equal((await request('POST', `/orders/${order.id}/cancel`)).status, 200);
+});
+
+test('S5: pay after cancel is rejected with 409 and does not charge', async () => {
+  const order = await createOrder(80);
+  await request('POST', `/orders/${order.id}/cancel`);
+  const res = await request('POST', `/orders/${order.id}/pay`);
+  assert.equal(res.status, 409);
+  assert.deepEqual(await chargesFor(order.id), []);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'cancelled');
+});
+
+test('S5: cancel after pay is rejected with 409 and the order stays paid', async () => {
+  const order = await createOrder(80);
+  await request('POST', `/orders/${order.id}/pay`);
+  const res = await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal(res.status, 409);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+  assert.equal((await chargesFor(order.id)).length, 1);
+});
+
+test('S7: an unexpected charge failure releases the order so it can be paid again', async () => {
+  const order = orders.createOrder({ amount: 40 });
+  const boom = new Error('gateway unreachable');
+  await assert.rejects(orders.payOrder(order.id, async () => { throw boom; }), boom);
+  assert.equal(orders.getOrder(order.id).status, 'pending');
+  const paid = await orders.payOrder(order.id, async () => ({ chargeId: 'ok' }));
+  assert.equal(paid.status, 'paid');
+});
