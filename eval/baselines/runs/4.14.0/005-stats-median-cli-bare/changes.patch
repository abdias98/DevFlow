diff --git a/src/cli.js b/src/cli.js
index b938179..d6e09f2 100644
--- a/src/cli.js
+++ b/src/cli.js
@@ -3,7 +3,7 @@
 const { COMMANDS } = require('./commands');
 const { parseNumbers, UsageError } = require('./parse');
 
-const USAGE = 'usage: stats <sum|mean|max> <number...>\n';
+const USAGE = 'usage: stats <sum|mean|max|median> <number...>\n';
 
 // Pure entry point: returns what the process should print and exit with, so it
 // can be tested without spawning anything.
diff --git a/src/commands.js b/src/commands.js
index 8daf2ee..27646ae 100644
--- a/src/commands.js
+++ b/src/commands.js
@@ -18,6 +18,12 @@ const COMMANDS = {
     return numbers.reduce((a, b) => a + b, 0) / numbers.length;
   },
   max: (numbers) => Math.max(...requireNumbers(numbers, 'max')),
+  median: (numbers) => {
+    requireNumbers(numbers, 'median');
+    const sorted = [...numbers].sort((a, b) => a - b);
+    const mid = Math.floor(sorted.length / 2);
+    return sorted.length % 2 === 1 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
+  },
 };
 
 module.exports = { COMMANDS, requireNumbers };
diff --git a/test/cli.test.js b/test/cli.test.js
index 3a7de8e..9117a93 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -33,3 +33,35 @@ test('an unknown command prints the usage', () => {
   assert.equal(result.code, 1);
   assert.match(result.stderr, /unknown command: nope/);
 });
+
+test('median returns the middle number of an unsorted list', () => {
+  assert.deepEqual(run(['median', '3', '1', '2']), { code: 0, stdout: '2\n', stderr: '' });
+});
+
+test('median of an even count averages the two middle numbers', () => {
+  assert.equal(run(['median', '4', '1', '3', '2']).stdout, '2.5\n');
+});
+
+test('median of a single number is that number', () => {
+  assert.equal(run(['median', '7']).stdout, '7\n');
+});
+
+test('median sorts numerically, not lexicographically', () => {
+  assert.equal(run(['median', '10', '9', '100']).stdout, '10\n');
+});
+
+test('median handles negatives and does not mutate its input order', () => {
+  assert.equal(run(['median', '-5', '5', '0']).stdout, '0\n');
+});
+
+test('median with no numbers is a usage error', () => {
+  const result = run(['median']);
+  assert.equal(result.code, 1);
+  assert.match(result.stderr, /median: no numbers given/);
+});
+
+test('median names a non-numeric argument', () => {
+  const result = run(['median', '1', 'x']);
+  assert.equal(result.code, 1);
+  assert.match(result.stderr, /not a number: x/);
+});
