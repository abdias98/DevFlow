 'use strict';
 
+const fs = require('node:fs');
 const { createStore, NoteError } = require('./store');
 
-const USAGE = 'usage: notes <add <id> <title> | list>\n';
+const USAGE = 'usage: notes <add <id> <title> | import <file.json> | list>\n';
+
+// Reads an import file: a JSON array of notes. Anything wrong with the file
+// itself is the user's mistake (NoteError), not a crash.
+function readNotesFile(importPath) {
+  let text;
+  try {
+    text = fs.readFileSync(importPath, 'utf8');
+  } catch (err) {
+    throw new NoteError(`cannot read '${importPath}': ${err.code || err.message}`, { cause: err });
+  }
+  let notes;
+  try {
+    notes = JSON.parse(text);
+  } catch (err) {
+    throw new NoteError(`'${importPath}' is not valid JSON (${err.message})`, { cause: err });
+  }
+  if (!Array.isArray(notes)) {
+    throw new NoteError(`'${importPath}' must contain an array of notes`);
+  }
+  return notes;
+}
 
 // Pure entry point: returns what the process should print and exit with, so it
 // can be tested without spawning anything.
@@ -15,6 +37,14 @@ function run(argv, { file }) {
       store.add({ id, title: title.join(' ') });
       return { code: 0, stdout: `added ${id}\n`, stderr: '' };
     }
+    if (command === 'import') {
+      const [importPath, ...extra] = rest;
+      if (!importPath || extra.length > 0) return { code: 1, stdout: '', stderr: USAGE };
+      const notes = readNotesFile(importPath);
+      store.addMany(notes);
+      const count = `${notes.length} note${notes.length === 1 ? '' : 's'}`;
+      return { code: 0, stdout: `imported ${count}\n`, stderr: '' };
+    }
     if (command === 'list') {
       const lines = store.readAll().map((note) => `${note.id}: ${note.title}`);
       return { code: 0, stdout: lines.length ? `${lines.join('\n')}\n` : '', stderr: '' };
