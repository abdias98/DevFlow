+  // Adds several notes as one all-or-nothing operation: every note is
+  // validated and checked for duplicate ids (within the batch and against
+  // the stored notes) before anything is written, so a bad note never leaves
+  // the store partially updated.
+  function addMany(notes) {
+    notes.forEach(validateNote);
+    const existing = readAll();
+    const seen = new Set(existing.map((note) => note.id));
+    for (const note of notes) {
+      if (seen.has(note.id)) throw new NoteError(`duplicate id: ${note.id}`);
+      seen.add(note.id);
+    }
+    if (notes.length === 0) return;
+    writeAll(existing.concat(notes.map(({ id, title }) => ({ id, title }))));
+  }
+
   return {
     readAll,
+    addMany,
 
     // Adds one note; the id must be new.
     add(note) {
