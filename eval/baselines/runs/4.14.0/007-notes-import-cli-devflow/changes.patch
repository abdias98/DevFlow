+
+test('store.addMany appends every note in order and keeps only id and title', () => {
+  const file = tmpStore();
+  const store = createStore(file);
+  store.add({ id: 'n1', title: 'First' });
+  store.addMany([
+    { id: 'n2', title: 'Second', extra: 'ignored' },
+    { id: 'n3', title: 'Third' },
+  ]);
+  assert.deepEqual(store.readAll(), [
+    { id: 'n1', title: 'First' },
+    { id: 'n2', title: 'Second' },
+    { id: 'n3', title: 'Third' },
+  ]);
+});
+
+const badBatches = {
+  'a note is invalid': [{ id: 'a', title: 'ok' }, { id: 'b', title: '' }],
+  'an id is repeated in the batch': [{ id: 'a', title: 'ok' }, { id: 'a', title: 'again' }],
+  'an id is already stored': [{ id: 'a', title: 'ok' }, { id: 'n1', title: 'clash' }],
+};
+for (const [reason, batch] of Object.entries(badBatches)) {
+  test(`store.addMany writes nothing when ${reason}`, () => {
+    const file = tmpStore();
+    const store = createStore(file);
+    store.add({ id: 'n1', title: 'First' });
+    const before = fs.readFileSync(file, 'utf8');
+    assert.throws(() => store.addMany(batch), NoteError);
+    assert.equal(fs.readFileSync(file, 'utf8'), before);
+  });
+}
+
+// Writes an import file (raw text or a value to serialise) next to a temp store.
+function importFile(content) {
+  const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'notes-import-')), 'in.json');
+  fs.writeFileSync(file, typeof content === 'string' ? content : JSON.stringify(content));
+  return file;
+}
+
+test('import adds every note in the file after the existing ones', () => {
+  const file = tmpStore();
+  run(['add', 'n1', 'First'], { file });
+  const result = run(['import', importFile([
+    { id: 'n2', title: 'Second' },
+    { id: 'n3', title: 'Third' },
+  ])], { file });
+  assert.equal(result.code, 0);
+  assert.equal(result.stdout, 'imported 2 notes\n');
+  assert.equal(run(['list'], { file }).stdout, 'n1: First\nn2: Second\nn3: Third\n');
+});
+
+test('import of one note reports it in the singular', () => {
+  const result = run(['import', importFile([{ id: 'n1', title: 'Only' }])], { file: tmpStore() });
+  assert.equal(result.code, 0);
+  assert.equal(result.stdout, 'imported 1 note\n');
+});
+
+test('import of an empty array succeeds and leaves the store untouched', () => {
+  const file = tmpStore();
+  const result = run(['import', importFile([])], { file });
+  assert.equal(result.code, 0);
+  assert.equal(result.stdout, 'imported 0 notes\n');
+  assert.equal(fs.existsSync(file), false);
+});
+
+test('importing the same file twice fails the second time and changes nothing', () => {
+  const file = tmpStore();
