diff --git a/src/customers.js b/src/customers.js
index 4b1ff9c..8ce3c60 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -9,23 +9,66 @@
 //
 // A customer is { id, name, archived }. Archived customers are hidden from
 // lookups unless the caller asks for them.
+//
+// Lookups are cached per service instance. The cache holds the store's record
+// as it is (archived or not), keyed by id, and the archived rule is applied on
+// every read: the record depends on nothing but the id, the answer also depends
+// on includeArchived. Only customers that exist are kept: a miss or a failure
+// is never remembered. The cache assumes this service is the only writer.
 function createCustomerService({ store }) {
+  // id -> Promise<record | undefined> of store.find(id). Keeping the promise
+  // lets overlapping lookups of one id share a single call.
+  const cache = new Map();
+
+  // Drops the entry, but only if it is still the current one: a lookup that was
+  // superseded by an eviction must not remove (or restore) its successor.
+  function forget(id, entry) {
+    if (cache.get(id) === entry) cache.delete(id);
+  }
+
+  function lookup(id) {
+    const cached = cache.get(id);
+    if (cached) return cached;
+    const entry = store.find(id).then(
+      (customer) => {
+        if (!customer) forget(id, entry);
+        return customer;
+      },
+      (error) => {
+        forget(id, entry);
+        throw error;
+      },
+    );
+    cache.set(id, entry);
+    return entry;
+  }
+
+  // The one write path. The entry is dropped when the write settles, whether it
+  // succeeded or failed: after a failure the store's state is unknown.
+  async function write(id, changes) {
+    try {
+      return await store.update(id, changes);
+    } finally {
+      cache.delete(id);
+    }
+  }
+
   return {
     // Resolves the customer, or null when there is none (or it is archived and
-    // includeArchived is not set).
+    // includeArchived is not set). Every caller gets its own copy.
     async getCustomer(id, { includeArchived = false } = {}) {
-      const customer = await store.find(id);
+      const customer = await lookup(id);
       if (!customer) return null;
       if (customer.archived && !includeArchived) return null;
-      return customer;
+      return structuredClone(customer);
     },
 
     async updateCustomer(id, changes) {
-      return store.update(id, changes);
+      return write(id, changes);
     },
 
     async archiveCustomer(id) {
-      return store.update(id, { archived: true });
+      return write(id, { archived: true });
     },
   };
 }
