diff --git a/src/cli.js b/src/cli.js
index b938179..d6e09f2 100644
--- a/src/cli.js
+++ b/src/cli.js
@@ -3,7 +3,7 @@
 const { COMMANDS } = require('./commands');
 const { parseNumbers, UsageError } = require('./parse');
 
-const USAGE = 'usage: stats <sum|mean|max> <number...>\n';
+const USAGE = 'usage: stats <sum|mean|max|median> <number...>\n';
 
 // Pure entry point: returns what the process should print and exit with, so it
 // can be tested without spawning anything.
diff --git a/src/commands.js b/src/commands.js
index 8daf2ee..f393bac 100644
--- a/src/commands.js
+++ b/src/commands.js
@@ -18,6 +18,15 @@ const COMMANDS = {
     return numbers.reduce((a, b) => a + b, 0) / numbers.length;
   },
   max: (numbers) => Math.max(...requireNumbers(numbers, 'max')),
+  median: (numbers) => {
+    // Numeric comparator: the default sort would order 10 before 9.
+    const sorted = [...requireNumbers(numbers, 'median')].sort((a, b) => a - b);
+    const mid = Math.floor(sorted.length / 2);
+    if (sorted.length % 2 === 1) return sorted[mid];
+    const [lo, hi] = [sorted[mid - 1], sorted[mid]];
+    // A median always lies between its inputs, so halve first if the sum overflows.
+    return Number.isFinite(lo + hi) ? (lo + hi) / 2 : lo / 2 + hi / 2;
+  },
 };
 
 module.exports = { COMMANDS, requireNumbers };
diff --git a/test/cli.test.js b/test/cli.test.js
index 3a7de8e..93e4ce1 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -33,3 +33,53 @@ test('an unknown command prints the usage', () => {
   assert.equal(result.code, 1);
   assert.match(result.stderr, /unknown command: nope/);
 });
+
+test('median returns the middle number regardless of argument order', () => {
+  assert.deepEqual(run(['median', '3', '1', '2']), { code: 0, stdout: '2\n', stderr: '' });
+  assert.equal(run(['median', '2', '3', '1']).stdout, '2\n');
+});
+
+test('median of an even count is the mean of the two middle numbers', () => {
+  assert.equal(run(['median', '1', '2', '3', '4']).stdout, '2.5\n');
+  assert.equal(run(['median', '4', '1']).stdout, '2.5\n');
+});
+
+test('median orders numerically, not as text', () => {
+  assert.equal(run(['median', '10', '9', '2']).stdout, '9\n');
+});
+
+test('median of a single number is that number', () => {
+  assert.equal(run(['median', '-7.5']).stdout, '-7.5\n');
+});
+
+test('median handles duplicates and negative numbers', () => {
+  assert.equal(run(['median', '-1', '-1', '5', '0', '0']).stdout, '0\n');
+});
+
+test('median with no numbers is a usage error', () => {
+  const result = run(['median']);
+  assert.equal(result.code, 1);
+  assert.match(result.stderr, /median: no numbers given/);
+});
+
+test('median with a non-numeric argument names it in the error', () => {
+  const result = run(['median', '1', 'abc', '3']);
+  assert.equal(result.code, 1);
+  assert.match(result.stderr, /not a number: abc/);
+});
+
+test('the usage lists the median command', () => {
+  const result = run(['--help']);
+  assert.equal(result.code, 0);
+  assert.match(result.stdout, /median/);
+});
+
+test('median of two huge numbers stays finite (discovered: sum overflow)', () => {
+  assert.equal(run(['median', '1.7e308', '1.7e308']).stdout, '1.7e+308\n');
+  assert.equal(run(['median', '-1.7e308', '1.7e308']).stdout, '0\n');
+  assert.equal(run(['median', '-1.7e308', '-1.7e308']).stdout, '-1.7e+308\n');
+});
+
+test('median keeps full precision when the sum does not overflow (subnormals)', () => {
+  assert.equal(run(['median', '5e-324', '5e-324']).stdout, '5e-324\n');
+});
