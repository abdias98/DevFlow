+
+test('selecting the tasks tab loads the tasks of the selected project', async () => {
+  const list = [{ id: 't1', title: 'Ship it' }];
+  const panel = createProjectPanel({ api: fakeApi({ p1: { name: 'Apollo' } }, { p1: list }) });
+  panel.selectProject('p1');
+  await tick();
+  assert.equal(panel.getState().tasks.status, 'idle');
+  panel.selectTab('tasks');
+  assert.equal(panel.getState().activeTab, 'tasks');
+  assert.equal(panel.getState().tasks.status, 'loading');
+  await tick();
+  assert.deepEqual(panel.getState().tasks, { status: 'ready', data: list, error: null });
+});
+
+test('selecting the tasks tab without a project does not load', async () => {
+  let calls = 0;
+  const api = { getTasks: async () => { calls += 1; return []; } };
+  const panel = createProjectPanel({ api });
+  panel.selectTab('tasks');
+  await tick();
+  assert.equal(calls, 0);
+  assert.equal(panel.getState().tasks.status, 'idle');
+});
+
+test('selecting a project while on the tasks tab loads its tasks', async () => {
+  const panel = createProjectPanel({ api: fakeApi({}, { p1: ['a'] }) });
+  panel.selectTab('tasks');
+  panel.selectProject('p1');
+  await tick();
+  assert.deepEqual(panel.getState().tasks, { status: 'ready', data: ['a'], error: null });
+});
+
+test('a failed tasks request surfaces an error state', async () => {
+  const boom = new Error('boom');
+  const api = { getTasks: async () => { throw boom; } };
+  const panel = createProjectPanel({ api });
+  panel.selectTab('tasks');
+  panel.selectProject('p1');
+  await tick();
+  assert.deepEqual(panel.getState().tasks, { status: 'error', data: null, error: boom });
+});
+
+test('selecting another project resets tasks and requests the new project', async () => {
+  const panel = createProjectPanel({ api: fakeApi({}, { p1: ['a'], p2: ['b'] }) });
+  panel.selectTab('tasks');
+  panel.selectProject('p1');
+  await tick();
+  panel.selectProject('p2');
+  assert.deepEqual(panel.getState().tasks, { status: 'loading', data: null, error: null });
+  await tick();
+  assert.deepEqual(panel.getState().tasks.data, ['b']);
+});
+
+test('a slow tasks response for a previous project is ignored', async () => {
+  const pending = {};
+  const api = {
+    getTasks: (id) => new Promise((resolve) => { pending[id] = resolve; }),
+  };
+  const panel = createProjectPanel({ api });
+  panel.selectTab('tasks');
+  panel.selectProject('p1');
+  panel.selectProject('p2');
+  pending.p2(['b']);
+  await tick();
+  pending.p1(['a']);
+  await tick();
+  assert.deepEqual(panel.getState().tasks, { status: 'ready', data: ['b'], error: null });
+});
+
+test('a slow tasks failure for a previous project is ignored', async () => {
+  const pending = {};
+  const api = {
+    getTasks: (id) => new Promise((resolve, reject) => { pending[id] = { resolve, reject }; }),
+  };
+  const panel = createProjectPanel({ api });
+  panel.selectTab('tasks');
+  panel.selectProject('p1');
+  panel.selectProject('p2');
+  pending.p2.resolve(['b']);
+  await tick();
+  pending.p1.reject(new Error('late'));
+  await tick();
+  assert.equal(panel.getState().tasks.status, 'ready');
+});
+
+test('tasks state changes are emitted to subscribers', async () => {
+  const panel = createProjectPanel({ api: fakeApi({}, { p1: ['a'] }) });
+  const seen = [];
+  panel.subscribe((s) => seen.push(s.tasks.status));
+  panel.selectTab('tasks');
+  panel.selectProject('p1');
+  await tick();
+  assert.deepEqual(seen, ['loading', 'ready']);
+});
