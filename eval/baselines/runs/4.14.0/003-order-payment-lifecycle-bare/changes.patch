diff --git a/test/orders.test.js b/test/orders.test.js
index 26212c5..654b6ea 100644
--- a/test/orders.test.js
+++ b/test/orders.test.js
@@ -48,3 +48,92 @@ test('GET /orders/:id returns 404 for an unknown order', async () => {
   const res = await request('GET', '/orders/does-not-exist');
   assert.equal(res.status, 404);
 });
+
+async function createOrder(amount) {
+  return (await request('POST', '/orders', { amount })).body;
+}
+
+test('POST /orders/:id/pay charges the amount and marks the order paid', async () => {
+  const order = await createOrder(300);
+  const res = await request('POST', `/orders/${order.id}/pay`);
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, { ...order, status: 'paid' });
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+  const charges = (await request('GET', '/ledger')).body.filter((c) => c.orderId === order.id);
+  assert.equal(charges.length, 1);
+  assert.equal(charges[0].amount, 300);
+});
+
+test('POST /orders/:id/pay returns 404 for an unknown order', async () => {
+  assert.equal((await request('POST', '/orders/nope/pay')).status, 404);
+});
+
+test('paying an already paid order is rejected and not charged twice', async () => {
+  const order = await createOrder(120);
+  await request('POST', `/orders/${order.id}/pay`);
+  const res = await request('POST', `/orders/${order.id}/pay`);
+  assert.equal(res.status, 409);
+  const charges = (await request('GET', '/ledger')).body.filter((c) => c.orderId === order.id);
+  assert.equal(charges.length, 1);
+});
+
+test('concurrent pay requests charge the order only once', async () => {
+  const order = await createOrder(75);
+  const results = await Promise.all([
+    request('POST', `/orders/${order.id}/pay`),
+    request('POST', `/orders/${order.id}/pay`),
+    request('POST', `/orders/${order.id}/pay`),
+  ]);
+  assert.deepEqual(results.map((r) => r.status).sort(), [200, 409, 409]);
+  const charges = (await request('GET', '/ledger')).body.filter((c) => c.orderId === order.id);
+  assert.equal(charges.length, 1);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+});
+
+test('a declined charge returns 402 and leaves the order pending', async () => {
+  const order = await createOrder(10001);
+  const res = await request('POST', `/orders/${order.id}/pay`);
+  assert.equal(res.status, 402);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'pending');
+  const charges = (await request('GET', '/ledger')).body.filter((c) => c.orderId === order.id);
+  assert.equal(charges.length, 0);
+});
+
+test('POST /orders/:id/cancel marks a pending order cancelled', async () => {
+  const order = await createOrder(60);
+  const res = await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, { ...order, status: 'cancelled' });
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'cancelled');
+});
+
+test('POST /orders/:id/cancel returns 404 for an unknown order', async () => {
+  assert.equal((await request('POST', '/orders/nope/cancel')).status, 404);
+});
+
+test('a cancelled order cannot be paid or cancelled again', async () => {
+  const order = await createOrder(40);
+  await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal((await request('POST', `/orders/${order.id}/pay`)).status, 409);
+  assert.equal((await request('POST', `/orders/${order.id}/cancel`)).status, 409);
+  const charges = (await request('GET', '/ledger')).body.filter((c) => c.orderId === order.id);
+  assert.equal(charges.length, 0);
+});
+
+test('a paid order cannot be cancelled', async () => {
+  const order = await createOrder(55);
+  await request('POST', `/orders/${order.id}/pay`);
+  const res = await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal(res.status, 409);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+});
+
+test('cancelling while a payment is in flight is rejected', async () => {
+  const order = await createOrder(85);
+  const paying = request('POST', `/orders/${order.id}/pay`);
+  await new Promise((r) => setTimeout(r, 10));
+  const cancel = await request('POST', `/orders/${order.id}/cancel`);
+  assert.equal(cancel.status, 409);
+  assert.equal((await paying).status, 200);
+  assert.equal((await request('GET', `/orders/${order.id}`)).body.status, 'paid');
+});
