 'use strict';
 
+const fs = require('node:fs');
 const { createStore, NoteError } = require('./store');
 
-const USAGE = 'usage: notes <add <id> <title> | list>\n';
+const USAGE = 'usage: notes <add <id> <title> | list | import <file.json>>\n';
+
+function readImportFile(source) {
+  let text;
+  try {
+    text = fs.readFileSync(source, 'utf8');
+  } catch (err) {
+    throw new NoteError(`cannot read ${source}: ${err.code || err.message}`);
+  }
+  let data;
+  try {
+    data = JSON.parse(text);
+  } catch {
+    throw new NoteError(`invalid JSON in ${source}`);
+  }
+  if (!Array.isArray(data)) throw new NoteError(`${source} must contain an array of notes`);
+  return data;
+}
 
