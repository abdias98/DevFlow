#!/usr/bin/env bash
# devflow-ctl — Deterministic enforcement CLI for the DevFlow framework.
#
# Agents invoke this script at gate transitions instead of self-verifying
# session state. All checks are binary (exit codes), so the result is
# incontestable regardless of which editor or model is driving the session.
#
# Session state lives in the YAML frontmatter of:
#   docs/devflow/session/{slug}/phase-state.md
# (override the root with DEVFLOW_SESSION_ROOT)
#
# Exit codes: 0 = check passed / action done
#             1 = check FAILED (gate closed, scope violation, limit exceeded)
#             2 = usage or state error (missing session, bad arguments)
#
# Usage: devflow-ctl <command> [args] [--slug <slug>]
#
#   init --mode <m> --slug <s> [--scope <glob>]...   Create session + acquire lock
#   status                                           Print session summary
#   phase get | set <N>                              Read / record current phase
#   gate check <name>                                Exit 1 unless gate is open
#   gate set <name> <value>                          Validated state transition
#   scope check <file>                               Exit 1 unless Core or Impact Zone (see impact)
#   scope add <glob>                                 Append a glob to the Core scope
#   scope impact <file> [--record]                   Discover dependents/dependencies; --record persists them
#   scope justify <file> <reason>                    Record why an Impact Zone edit is a coherence change
#   scope audit [<file>...]                          Exit 1 if a modified Impact Zone file has no justification
#   iterate <loop> [--max <N>]                       Increment loop counter; exit 1 over limit
#   lock check | acquire <agent> [--force] | release Manage the session lock
#   config set <key> <value> | get <key>             Session settings (branch, pair_mode, mode, phase, rigor)
#   checkpoint set <name> <sha> | get <name>         Record / read rollback SHAs
#   artifacts check <type> <path>                    Validate required sections
#   capabilities [get <key>]                         Print environment capabilities (from .devflow-environment)
#   knowledge list                                   List entries in the knowledge base
#   knowledge add <file>                             Add a knowledge base entry from a file
#   backlog add <file> <reason> [--severity b|i|f]    Record a deferred (Outside-zone) finding
#   backlog list [--area <glob>]                      List deferred findings, optionally by area
#   metrics aggregate <metrics-file>                  Append a cycle's metrics to _aggregate.md, recompute averages
#   traceability check <file>                         Count Source/TOTAL coverage in a traceability matrix; exit 1 if <100%
#   sessions                                         List all active DevFlow sessions with phase and state
#   clean [--force]                                  Remove sessions unlocked/stale ≥30 min (never `status: cancelled`); --force removes all
#   scan [secrets|sca|sast|all]                      Deterministic security scan (exit 1 on findings)
#   doctor                                           Diagnose install/session health (exit 1 on failures)
#
# Gates:    validation (pending|passed|blocked|accepted-risks)
#           confirmation, plan_approval (pending|approved|rejected)
# Loops:    implement_review, implement_debug (max 3); plan_revision,
#           validation_brainstorm (max 2). DEVFLOW_MAX_ITERATIONS overrides all.

set -euo pipefail

SESSION_ROOT="${DEVFLOW_SESSION_ROOT:-docs/devflow/session}"
SCHEMA_VERSION=1
STALE_LOCK_MINUTES=30

# ── Output helpers ────────────────────────────────────────────────────────────

ok()   { echo "[devflow-ctl] OK: $*"; }
fail() { echo "[devflow-ctl] FAIL: $*" >&2; exit 1; }
die()  { echo "[devflow-ctl] ERROR: $*" >&2; exit 2; }

# A slug names a directory under SESSION_ROOT and is interpolated into paths.
# Reject path separators, traversal, and shell metacharacters so a crafted
# --slug can never escape SESSION_ROOT or reach a shell context.
validate_slug() {
  local s="$1"
  case "$s" in
    */*|*..*) die "invalid slug '$s' — '/' and '..' are not allowed (path traversal)" ;;
  esac
  [[ "$s" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || die "invalid slug '$s' — must start alphanumeric; allowed chars: letters, digits, '.', '_', '-'"
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Convert ISO-8601 UTC timestamp to epoch seconds (GNU date, then BSD fallback).
to_epoch() {
  local ts="$1"
  date -d "$ts" +%s 2>/dev/null \
    || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s 2>/dev/null \
    || echo 0
}

# ── Session resolution ────────────────────────────────────────────────────────

SLUG=""
STATE_FILE=""

# Extract a global --slug flag from anywhere in the argument list.
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --slug) SLUG="${2:-}"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# Validate any explicitly supplied slug at the input boundary (covers init and
# every command that takes --slug). Auto-resolved slugs come from directory
# basenames and are already trusted.
[[ -n "$SLUG" ]] && validate_slug "$SLUG"

# Populates the global array _SESSIONS with every slug that has a
# phase-state.md under SESSION_ROOT. Shared by resolve_session and any
# command that needs to know the session count before committing to one
# (e.g. `lock check` treats zero sessions as "nothing to lock", not an error).
_discover_sessions() {
  _SESSIONS=()
  if [[ -d "$SESSION_ROOT" ]]; then
    while IFS= read -r f; do
      _SESSIONS+=("$(basename "$(dirname "$f")")")
    done < <(find "$SESSION_ROOT" -mindepth 2 -maxdepth 2 -name phase-state.md 2>/dev/null)
  fi
}

# True (exit 0) if the given slug's session has a lock that is held (not
# "none"/empty) and not stale. Reads the frontmatter directly — this runs
# before any candidate slug has been chosen, so STATE_FILE/fm_get aren't
# set up yet (same direct-read pattern as cmd_sessions/cmd_clean).
_has_active_lock() {
  local slug="$1" statefile="$SESSION_ROOT/$1/phase-state.md"
  local locked_by locked_since epoch age_min
  locked_by="$(awk '/^locked_by:/{sub(/^locked_by: */,"");print;exit}' "$statefile" 2>/dev/null)"
  [[ -n "$locked_by" && "$locked_by" != "none" ]] || return 1
  locked_since="$(awk '/^locked_since:/{sub(/^locked_since: */,"");print;exit}' "$statefile" 2>/dev/null)"
  epoch="$(to_epoch "$locked_since")"
  [[ "$epoch" != 0 ]] || return 1
  age_min=$(( ($(date +%s) - epoch) / 60 ))
  (( age_min < STALE_LOCK_MINUTES ))
}

resolve_session() {
  if [[ -z "$SLUG" ]]; then
    _discover_sessions
    case "${#_SESSIONS[@]}" in
      0) die "no active session found under $SESSION_ROOT — run 'devflow-ctl init' first" ;;
      1) SLUG="${_SESSIONS[0]}" ;;
      *)
        # 2+ sessions on disk is ambiguous by default, but if exactly one of
        # them currently holds an active (non-stale) lock, that is the live
        # cycle an agent means when it omits --slug — the rest are abandoned
        # or completed sessions still sitting on disk. Pick it and say so.
        local locked_candidates=()
        for s in "${_SESSIONS[@]}"; do
          _has_active_lock "$s" && locked_candidates+=("$s")
        done
        case "${#locked_candidates[@]}" in
          1)
            SLUG="${locked_candidates[0]}"
            echo "[devflow-ctl] OK: multiple sessions on disk (${_SESSIONS[*]}) — resolved to '$SLUG' (the only one with an active lock)" >&2
            ;;
          *) die "multiple active sessions (${_SESSIONS[*]}) — disambiguate with --slug" ;;
        esac
        ;;
    esac
  fi
  STATE_FILE="$SESSION_ROOT/$SLUG/phase-state.md"
  [[ -f "$STATE_FILE" ]] || die "no phase-state.md for slug '$SLUG' at $STATE_FILE"
  head -1 "$STATE_FILE" | grep -q '^---$' \
    || die "$STATE_FILE has no YAML frontmatter — created by an older DevFlow version? Re-run 'devflow-ctl init'"
}

# ── Frontmatter primitives ────────────────────────────────────────────────────
# The frontmatter is a restricted YAML subset: flat keys, one level of nesting
# (gates:, iterations:, checkpoints:), and one list (scope:). Values are plain
# scalars — no quoting, anchors, or multi-line values.

fm_get() { # fm_get <key>  (dotted for nested, e.g. gates.confirmation)
  local key="$1"
  awk -v key="$key" '
    BEGIN { n = split(key, p, "."); infm = 0; sect = "" }
    NR == 1 && $0 == "---" { infm = 1; next }
    infm && $0 == "---"    { exit }
    !infm                  { next }
    /^[A-Za-z_][A-Za-z0-9_-]*:/ {
      k = $0; sub(/:.*/, "", k)
      if (n == 1 && k == key) { v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); print v; exit }
      sect = ($0 ~ /:[[:space:]]*$/) ? k : ""
      next
    }
    n == 2 && sect == p[1] && /^  [A-Za-z_][A-Za-z0-9_-]*:/ {
      k = $0; sub(/^  /, "", k); sub(/:.*/, "", k)
      if (k == p[2]) { v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); print v; exit }
    }
  ' "$STATE_FILE"
}

fm_set() { # fm_set <key> <value> — replace in place, or append (creating the section if nested)
  local key="$1" value="$2" tmp
  tmp="$(mktemp)"
  awk -v key="$key" -v val="$value" '
    BEGIN { n = split(key, p, "."); infm = 0; sect = ""; done = 0 }
    NR == 1 && $0 == "---" { infm = 1; print; next }
    infm && $0 == "---" && !closed {
      if (!done) {
        if (n == 1) print key ": " val
        else if (sect == p[1]) print "  " p[2] ": " val
        else { print p[1] ":"; print "  " p[2] ": " val }
      }
      closed = 1; infm = 0; print; next
    }
    !infm { print; next }
    /^[A-Za-z_][A-Za-z0-9_-]*:/ {
      k = $0; sub(/:.*/, "", k)
      # Leaving the target section without finding the subkey: append it now.
      if (n == 2 && sect == p[1] && k != p[1] && !done) { print "  " p[2] ": " val; done = 1 }
      if (n == 1 && k == key && !done) { print key ": " val; done = 1; sect = ""; next }
      sect = ($0 ~ /:[[:space:]]*$/) ? k : ""
      if (n == 2 && sect == p[1]) sect_seen = 1
      print; next
    }
    n == 2 && sect == p[1] && /^  [A-Za-z_][A-Za-z0-9_-]*:/ {
      k = $0; sub(/^  /, "", k); sub(/:.*/, "", k)
      if (k == p[2] && !done) { print "  " p[2] ": " val; done = 1; next }
    }
    { print }
  ' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

fm_list() { # fm_list <key> — print one list item per line
  local key="$1"
  awk -v key="$key" '
    BEGIN { infm = 0; insect = 0 }
    NR == 1 && $0 == "---" { infm = 1; next }
    infm && $0 == "---"    { exit }
    !infm                  { next }
    /^[A-Za-z_][A-Za-z0-9_-]*:/ {
      k = $0; sub(/:.*/, "", k)
      insect = (k == key)
      next
    }
    insect && /^  - / { v = $0; sub(/^  - /, "", v); print v }
  ' "$STATE_FILE"
}

fm_list_add() { # fm_list_add <key> <item> — append to a list, creating the section if missing
  local key="$1" item="$2" tmp
  tmp="$(mktemp)"
  awk -v key="$key" -v item="$item" '
    BEGIN { infm = 0; insect = 0; done = 0 }
    NR == 1 && $0 == "---" { infm = 1; print; next }
    infm && $0 == "---" {
      if (!done) { print key ":"; print "  - " item }
      infm = 0; print; next
    }
    !infm { print; next }
    /^[A-Za-z_][A-Za-z0-9_-]*:/ {
      k = $0; sub(/:.*/, "", k)
      if (insect && !done) { print "  - " item; done = 1 }
      insect = (k == key && !done)
      print; next
    }
    { print }
  ' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_init() {
  local mode="" scope_globs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)  mode="${2:-}"; shift 2 ;;
      --scope) scope_globs+=("${2:-}"); shift 2 ;;
      *) die "init: unknown argument '$1'" ;;
    esac
  done
  [[ -n "$mode" ]] || die "init: --mode is required (lifecycle|feature|refactor|bug-fix|perf|migrate|contract|docs|templates|tutorial|reverse)"
  [[ -n "$SLUG" ]] || die "init: --slug is required"
  STATE_FILE="$SESSION_ROOT/$SLUG/phase-state.md"
  [[ -f "$STATE_FILE" ]] && die "session '$SLUG' already exists at $STATE_FILE — resume it or pick another slug"

  mkdir -p "$SESSION_ROOT/$SLUG"
  {
    echo "---"
    echo "devflow: $SCHEMA_VERSION"
    echo "slug: $SLUG"
    echo "mode: $mode"
    echo "phase: 1"
    echo "pair_mode: false"
    echo "rigor: standard"
    echo "branch: none"
    echo "locked_by: Orchestrator"
    echo "locked_since: $(now_iso)"
    echo "gates:"
    if [[ "$mode" == "lifecycle" ]]; then
      echo "  validation: pending"
      echo "  confirmation: pending"
    else
      echo "  plan_approval: pending"
    fi
    if [[ ${#scope_globs[@]} -gt 0 ]]; then
      echo "scope:"
      for g in "${scope_globs[@]}"; do echo "  - $g"; done
    fi
    echo "iterations:"
    echo "checkpoints:"
    echo "---"
    echo ""
    echo "# DevFlow Phase State"
    echo ""
    echo "> Machine-readable state lives in the frontmatter above — manage it with \`devflow-ctl\`."
    echo "> The sections below are the human-readable session log."
    echo ""
    echo "## Iteration Log"
    echo "| # | From | To | Reason |"
    echo "|---|------|----|--------|"
    echo ""
    echo "## Escalation Log"
    echo "| # | Phases | Trigger | Attempts | Root Cause | User Decision |"
    echo "|---|--------|---------|:--------:|------------|---------------|"
  } > "$STATE_FILE"
  ok "session '$SLUG' initialized (mode: $mode, lock acquired) at $STATE_FILE"
}

cmd_status() {
  resolve_session
  echo "Session:   $SLUG (schema v$(fm_get devflow))"
  echo "Mode:      $(fm_get mode)"
  echo "Phase:     $(fm_get phase)"
  echo "Branch:    $(fm_get branch)"
  echo "Pair mode: $(fm_get pair_mode)"
  echo "Rigor:     $(fm_get rigor)"
  echo "Lock:      $(fm_get locked_by) (since $(fm_get locked_since))"
  echo "Gates:"
  for g in validation confirmation plan_approval; do
    local v; v="$(fm_get "gates.$g")"
    [[ -n "$v" ]] && echo "  $g: $v"
  done
  local scope; scope="$(fm_list scope)"
  if [[ -n "$scope" ]]; then
    echo "Scope:"
    while IFS= read -r g; do echo "  - $g"; done <<< "$scope"
  else
    echo "Scope:     (not declared)"
  fi
}

cmd_phase() {
  resolve_session
  case "${1:-}" in
    get) fm_get phase ;;
    set)
      [[ "${2:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "phase set: numeric phase required"
      fm_set phase "$2"
      ok "phase set to $2"
      ;;
    *) die "usage: devflow-ctl phase get|set <N>" ;;
  esac
}

gate_allowed_values() {
  case "$1" in
    validation)                 echo "pending passed blocked accepted-risks" ;;
    confirmation|plan_approval) echo "pending approved rejected" ;;
    *) return 1 ;;
  esac
}

cmd_gate() {
  resolve_session
  local action="${1:-}" gate="${2:-}" value="${3:-}"
  [[ -n "$gate" ]] || die "usage: devflow-ctl gate check|set <gate> [value]"
  gate_allowed_values "$gate" >/dev/null || die "unknown gate '$gate' (validation|confirmation|plan_approval)"
  local current; current="$(fm_get "gates.$gate")"

  case "$action" in
    check)
      [[ -n "$current" ]] || fail "gate '$gate' is not declared for this session (mode: $(fm_get mode))"
      case "$gate:$current" in
        validation:passed|validation:accepted-risks) ok "gate '$gate' is open ($current)" ;;
        confirmation:approved|plan_approval:approved) ok "gate '$gate' is open ($current)" ;;
        *) fail "gate '$gate' is CLOSED (state: $current) — do not proceed past this gate" ;;
      esac
      ;;
    set)
      [[ -n "$value" ]] || die "gate set: value required"
      local allowed; allowed="$(gate_allowed_values "$gate")"
      [[ " $allowed " == *" $value "* ]] || die "invalid value '$value' for gate '$gate' (allowed: $allowed)"
      # Transition invariants — illegal states are rejected no matter what the agent intends.
      if [[ "$gate" == "validation" && "$value" == "accepted-risks" && "$current" != "blocked" ]]; then
        die "validation can only move to 'accepted-risks' from 'blocked' (current: ${current:-unset}) — accepted-risks records a user decision over BLOCK findings"
      fi
      if [[ "$gate" == "confirmation" && "$value" == "approved" ]]; then
        local val_state; val_state="$(fm_get gates.validation)"
        if [[ -n "$val_state" && "$val_state" != "passed" && "$val_state" != "accepted-risks" ]]; then
          die "cannot approve confirmation while validation gate is '$val_state' — resolve the Validation Gate first"
        fi
      fi
      fm_set "gates.$gate" "$value"
      ok "gate '$gate': ${current:-unset} → $value"
      ;;
    *) die "usage: devflow-ctl gate check|set <gate> [value]" ;;
  esac
}

# Segment-aware glob match: `*` matches within a single path segment only —
# it never crosses `/`; `**` matches zero or more whole segments. Plain bash
# `[[ file == $pattern ]]` treats `*` and `**` identically (both cross `/`),
# which made a scope like `src/*` silently accept `src/a/b.ts` — this is the
# fix. Recursion relies on bash's dynamic scoping: fparts/pparts are `local`
# in _glob_match and stay visible to _glob_match_rec across the call chain.
_glob_match_rec() {
  local fi="$1" pi="$2"
  if (( pi == ${#pparts[@]} )); then
    (( fi == ${#fparts[@]} )); return
  fi
  if [[ "${pparts[$pi]}" == "**" ]]; then
    _glob_match_rec "$fi" $((pi + 1)) && return 0
    (( fi < ${#fparts[@]} )) && _glob_match_rec $((fi + 1)) "$pi" && return 0
    return 1
  fi
  (( fi < ${#fparts[@]} )) || return 1
  # shellcheck disable=SC2053
  [[ "${fparts[$fi]}" == ${pparts[$pi]} ]] || return 1
  _glob_match_rec $((fi + 1)) $((pi + 1))
}

_glob_match() {
  local file="$1" pattern="$2"
  local -a fparts pparts
  IFS='/' read -ra fparts <<< "$file"
  IFS='/' read -ra pparts <<< "$pattern"
  _glob_match_rec 0 0
}

# Repo-wide file listing excluding common build/dependency noise. Read-only,
# used only for impact discovery (never for anything that writes).
_scope_repo_files() {
  find . \
    -not -path '*/.git/*' \
    -not -path '*/node_modules/*' \
    -not -path '*/vendor/*' \
    -not -path '*/dist/*' \
    -not -path '*/build/*' \
    -not -path '*/.next/*' \
    -not -path '*/.venv/*' \
    -not -path '*/venv/*' \
    -not -path '*/__pycache__/*' \
    -not -path './docs/devflow/*' \
    -type f 2>/dev/null
}

# Deterministic, language-agnostic dependent/dependency discovery for one
# file — no parser, by design (rules.md → Scope-Locking — Three Zones): match
# the basename with its extension stripped as a whole word elsewhere in the
# repo (dependents), and resolve import/require/include/use/from/using lines
# inside the file to other files sharing that basename (dependencies). This
# is necessarily approximate — common names produce false positives — which
# is exactly why the Planner classifies each result (touch/skip/defer)
# instead of the CLI deciding anything on its own.
_scope_impact_discover() {
  local target="$1" base f
  base="$(basename "$target")"
  base="${base%.*}"
  [[ -n "$base" ]] || return 0

  while IFS= read -r f; do
    f="${f#./}"
    [[ "$f" == "$target" ]] && continue
    grep -qwF "$base" "$f" 2>/dev/null && printf '%s\tdependent\n' "$f"
  done < <(_scope_repo_files)

  local tok fbase
  while IFS= read -r tok; do
    [[ -z "$tok" || "$tok" == "$base" ]] && continue
    while IFS= read -r f; do
      f="${f#./}"
      [[ "$f" == "$target" ]] && continue
      fbase="${f##*/}"
      fbase="${fbase%.*}"
      [[ "$fbase" == "$tok" ]] && printf '%s\tdependency\n' "$f"
    done < <(_scope_repo_files)
  done < <(grep -EiI '\b(import|require|include|use|from|using)\b' "$target" 2>/dev/null \
            | grep -oE '[A-Za-z0-9_./-]+' \
            | sed -E 's#.*/##; s#\.[A-Za-z0-9]+$##' \
            | sort -u)
}

cmd_scope() {
  resolve_session
  case "${1:-}" in
    check)
      local file="${2:-}"
      [[ -n "$file" ]] || die "usage: devflow-ctl scope check <file>"
      file="${file#./}"
      # Flow Artifacts Exception (rules.md): DevFlow's own artifacts are always in scope.
      [[ "$file" == docs/devflow/* ]] && { ok "'$file' is a DevFlow artifact (always allowed)"; return; }
      local globs; globs="$(fm_list scope)"
      if [[ -n "$globs" ]]; then
        while IFS= read -r glob; do
          if _glob_match "$file" "$glob"; then
            ok "'$file' matches scope glob '$glob' (Core)"
            return
          fi
        done <<< "$globs"
      fi
      # Not Core — check the recorded Impact Zone (rules.md → Scope-Locking
      # — Three Zones) before failing outright.
      if fm_list impact | grep -qxF "$file"; then
        ok "'$file' is in the Impact Zone — coherence changes only; run 'scope justify' before editing"
        return
      fi
      [[ -n "$globs" ]] || fail "no scope declared for session '$SLUG' — declare it with 'scope add' before editing files"
      fail "'$file' is OUTSIDE the declared scope — ask the user for explicit approval, then 'scope add' it"
      ;;
    add)
      [[ -n "${2:-}" ]] || die "usage: devflow-ctl scope add <glob>"
      fm_list_add scope "$2"
      ok "scope extended with '$2'"
      ;;
    list) fm_list scope ;;
    impact)
      shift
      local target="" record=false a
      for a in "$@"; do
        case "$a" in
          --record) record=true ;;
          *) target="$a" ;;
        esac
      done
      if [[ -n "$target" ]]; then
        [[ -f "$target" ]] || die "scope impact: file not found: $target"
        target="${target#./}"
        local results; results="$(_scope_impact_discover "$target" | sort -u)"
        if [[ -z "$results" ]]; then
          echo "no dependents or dependencies found for '$target'"
        else
          printf 'path\trelation\n%s\n' "$results"
        fi
        if $record; then
          local path rel added=0
          while IFS=$'\t' read -r path rel; do
            [[ -n "$path" ]] || continue
            fm_list impact | grep -qxF "$path" || { fm_list_add impact "$path"; ((added++)) || true; }
          done <<< "$results"
          ok "impact zone updated for '$target' ($added new file(s))"
        fi
      else
        $record || die "usage: devflow-ctl scope impact <file> [--record] (bare --record with no file scans every file already in the declared scope)"
        local globs; globs="$(fm_list scope)"
        [[ -n "$globs" ]] || fail "no scope declared for session '$SLUG' — declare it with 'scope add' before running impact analysis"
        local f glob matched added=0 path rel
        while IFS= read -r f; do
          f="${f#./}"
          [[ "$f" == docs/devflow/* ]] && continue
          matched=false
          while IFS= read -r glob; do
            if _glob_match "$f" "$glob"; then matched=true; break; fi
          done <<< "$globs"
          $matched || continue
          while IFS=$'\t' read -r path rel; do
            [[ -n "$path" ]] || continue
            fm_list impact | grep -qxF "$path" || { fm_list_add impact "$path"; ((added++)) || true; }
          done < <(_scope_impact_discover "$f" | sort -u)
        done < <(_scope_repo_files)
        ok "impact zone recorded: $added new file(s) across the declared scope"
      fi
      ;;
    justify)
      local jfile="${2:-}" reason="${3:-}"
      [[ -n "$jfile" && -n "$reason" ]] || die 'usage: devflow-ctl scope justify <file> "<reason>"'
      jfile="${jfile#./}"
      fm_list impact | grep -qxF "$jfile" \
        || die "scope justify: '$jfile' is not in the recorded Impact Zone — run 'scope impact --record' first, or this file belongs in Core/Outside instead"
      fm_list_add justified "${jfile}::${reason}"
      ok "'$jfile' justified: $reason"
      ;;
    audit)
      shift
      local -a files=("$@")
      if [[ ${#files[@]} -eq 0 ]]; then
        local f
        while IFS= read -r f; do
          [[ -n "$f" ]] && files+=("$f")
        done < <({ git diff --name-only HEAD 2>/dev/null; git diff --name-only --cached 2>/dev/null; } | sort -u)
      fi
      local impact_list justified_list unjustified=() f jline hit
      impact_list="$(fm_list impact)"
      justified_list="$(fm_list justified)"
      for f in "${files[@]}"; do
        f="${f#./}"
        grep -qxF "$f" <<< "$impact_list" || continue
        hit=false
        while IFS= read -r jline; do
          [[ "${jline%%::*}" == "$f" ]] && { hit=true; break; }
        done <<< "$justified_list"
        $hit || unjustified+=("$f")
      done
      if [[ ${#unjustified[@]} -gt 0 ]]; then
        fail "modified Impact Zone file(s) without a recorded justification: ${unjustified[*]} — run 'scope justify {file} \"{reason}\"' for each"
      fi
      ok "all modified Impact Zone files are justified"
      ;;
    *) die "usage: devflow-ctl scope check <file> | add <glob> | list | impact <file> [--record] | justify <file> \"<reason>\" | audit [<file>...]" ;;
  esac
}

iterate_default_max() {
  case "$1" in
    implement_review|implement_debug) echo 3 ;;
    plan_revision|validation_brainstorm) echo 2 ;;
    *) echo 3 ;;
  esac
}

cmd_iterate() {
  resolve_session
  local loop="${1:-}"; shift || true
  [[ -n "$loop" ]] || die "usage: devflow-ctl iterate <loop> [--max <N>]"
  local max=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max) max="${2:-}"; shift 2 ;;
      *) die "iterate: unknown argument '$1'" ;;
    esac
  done
  max="${max:-${DEVFLOW_MAX_ITERATIONS:-$(iterate_default_max "$loop")}}"
  local count; count="$(fm_get "iterations.$loop")"
  count=$(( ${count:-0} + 1 ))
  fm_set "iterations.$loop" "$count"
  if (( count > max )); then
    fail "loop '$loop' exceeded its limit ($count > $max) — STOP iterating and escalate to the user with the structured triage"
  fi
  ok "loop '$loop' iteration $count of $max"
}

cmd_lock() {
  local action="${1:-}"
  # `lock check` with no explicit --slug and zero sessions on disk is the
  # normal starting state for every standalone agent's Step 0 -- not an
  # error. Every other case (acquire/release, or an explicit --slug that
  # doesn't exist, or 2+ sessions) still goes through resolve_session and
  # its usual exit-2 failures.
  if [[ "$action" == "check" && -z "$SLUG" ]]; then
    _discover_sessions
    if [[ ${#_SESSIONS[@]} -eq 0 ]]; then
      ok "no active session under $SESSION_ROOT (nothing to lock)"
      return 0
    fi
  fi
  resolve_session
  local holder since
  holder="$(fm_get locked_by)"
  since="$(fm_get locked_since)"
  case "$action" in
    check)
      if [[ -z "$holder" || "$holder" == "none" ]]; then
        ok "no active lock"
        return
      fi
      local age_min=-1 epoch; epoch="$(to_epoch "$since")"
      [[ "$epoch" != 0 ]] && age_min=$(( ($(date +%s) - epoch) / 60 ))
      if (( age_min >= STALE_LOCK_MINUTES )); then
        echo "[devflow-ctl] WARN: lock held by $holder is STALE (${age_min} min old) — it may be broken after informing the user"
        return 0
      fi
      fail "session locked by $holder since $since (${age_min} min ago) — do not write to this session"
      ;;
    acquire)
      local agent="${2:-}" force="${3:-}"
      [[ -n "$agent" ]] || die "usage: devflow-ctl lock acquire <agent> [--force]"
      if [[ -n "$holder" && "$holder" != "none" && "$holder" != "$agent" && "$force" != "--force" ]]; then
        local epoch; epoch="$(to_epoch "$since")"
        local age_min=$(( ($(date +%s) - epoch) / 60 ))
        (( age_min >= STALE_LOCK_MINUTES )) \
          || fail "lock held by $holder (${age_min} min ago) — wait, or pass --force to break a stale lock"
      fi
      fm_set locked_by "$agent"
      fm_set locked_since "$(now_iso)"
      ok "lock acquired by $agent"
      ;;
    release)
      fm_set locked_by "none"
      # Record the release time (not "-") so `clean` can measure how long
      # this session has been unlocked before treating it as safe to remove.
      fm_set locked_since "$(now_iso)"
      ok "lock released"
      ;;
    *) die "usage: devflow-ctl lock check | acquire <agent> [--force] | release" ;;
  esac
}

cmd_config() {
  resolve_session
  local action="${1:-}" key="${2:-}" value="${3:-}"
  case "$key" in
    branch|pair_mode|mode|phase|rigor|status) ;;
    *) die "config: key must be one of branch|pair_mode|mode|phase|rigor|status (gates and counters have their own commands)" ;;
  esac
  case "$action" in
    get) fm_get "$key" ;;
    set)
      [[ -n "$value" ]] || die "usage: devflow-ctl config set <key> <value>"
      if [[ "$key" == "pair_mode" && "$value" != "true" && "$value" != "false" ]]; then
        die "config: pair_mode must be 'true' or 'false'"
      fi
      if [[ "$key" == "rigor" ]]; then
        case "$value" in
          light|standard|deep|maximum) ;;
          *) die "config: rigor must be 'light', 'standard', 'deep', or 'maximum'" ;;
        esac
      fi
      if [[ "$key" == "status" && "$value" != "active" && "$value" != "cancelled" ]]; then
        die "config: status must be 'active' or 'cancelled'"
      fi
      fm_set "$key" "$value"
      ok "$key set to $value"
      ;;
    *) die "usage: devflow-ctl config set <key> <value> | get <key>" ;;
  esac
}

cmd_checkpoint() {
  resolve_session
  case "${1:-}" in
    set)
      [[ -n "${2:-}" && -n "${3:-}" ]] || die "usage: devflow-ctl checkpoint set <name> <sha>"
      fm_set "checkpoints.$2" "$3"
      ok "checkpoint '$2' = $3"
      ;;
    get)
      [[ -n "${2:-}" ]] || die "usage: devflow-ctl checkpoint get <name>"
      local v; v="$(fm_get "checkpoints.$2")"
      [[ -n "$v" ]] || die "checkpoint '$2' not recorded"
      echo "$v"
      ;;
    *) die "usage: devflow-ctl checkpoint set <name> <sha> | get <name>" ;;
  esac
}

# Required section patterns per artifact type (case-insensitive, matched
# against markdown headings). Kept in sync with shared/artifact-checklist.md.
artifacts_required() {
  case "$1" in
    spec)       printf '%s\n' "Digest" "Context" "Architecture" "Data Structures" "Reusability" "Test Architecture" "Risk" "Design Decisions" "Constraints" ;;
    plan)       printf '%s\n' "Digest" "File Map" "Task" "Self-Review" ;;
    review)     printf '%s\n' "Summary" "Findings" "Verdict" ;;
    validation) printf '%s\n' "Assumptions" "Standards Scan" "Contradictions" "Security" "Architecture Risks" "Alternatives" ;;
    feature)    printf '%s\n' "Summary" "Definition of Done" "Files Changed" "Tasks Completed" "Tests" "Self-Review" ;;
    bugfix)     printf '%s\n' "Bug Report" "Root Cause" "Reproduction Test" "Fix Applied" "Verification" "Definition of Done" ;;
    refactor)   printf '%s\n' "Scope" "Changes Applied" "Regression Guard" "Definition of Done" ;;
    perf)       printf '%s\n' "Summary" "Static Analysis Findings" "Benchmark Results" "Recommendations" ;;
    migration)  printf '%s\n' "Schema Changes" "Migration Files Generated" "Compatibility Analysis" "Rollback Plan" ;;
    contract)   printf '%s\n' "Endpoints Validated" "Contract Definition" "Discrepancies" "Coverage Summary" ;;
    docs)       printf '%s\n' "Documentation Generated" "Artifact Sources Used" ;;
    reverse)    printf '%s\n' "Project Overview" "Generated Artifacts" "Stack Profile" "Known Unknowns" ;;
    *) return 1 ;;
  esac
}

cmd_artifacts() {
  [[ "${1:-}" == "check" ]] || die "usage: devflow-ctl artifacts check <spec|plan|review|validation|feature|bugfix|refactor|perf|migration|contract|docs|reverse> <path>"
  local type="${2:-}" path="${3:-}"
  [[ -n "$type" && -n "$path" ]] || die "usage: devflow-ctl artifacts check <type> <path>"
  [[ -f "$path" ]] || fail "artifact not found at $path — it was never saved with create_file"
  local required missing=()
  required="$(artifacts_required "$type")" || die "unknown artifact type '$type' (spec|plan|review|validation|feature|bugfix|refactor|perf|migration|contract|docs|reverse)"
  while IFS= read -r section; do
    grep -qiE "^#{1,4} .*${section}" "$path" || missing+=("$section")
  done <<< "$required"
  if [[ ${#missing[@]} -gt 0 ]]; then
    fail "artifact '$path' is missing required section(s): ${missing[*]} — complete it before proceeding (see shared/artifact-checklist.md)"
  fi
  ok "artifact '$path' has all required $type sections"
}

# ── Environment capabilities ──────────────────────────────────────────────────
# Reads from .devflow-environment marker file (written by install.sh).
# Falls back to "unknown" for all primitives if the file is absent.

ENV_FILE=""
_detect_env_file() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  ENV_FILE="${script_dir}/../.devflow-environment"
}

cmd_capabilities() {
  _detect_env_file
  local action="${1:-print}"
  case "$action" in
    get)
      local key="${2:-}"
      [[ -n "$key" ]] || die "usage: devflow-ctl capabilities get <key> (subagents|vision|terminal|filesystem|profile)"
      local value="unknown"
      if [[ -f "$ENV_FILE" ]]; then
        value="$(grep -E "^${key}:" "$ENV_FILE" 2>/dev/null | head -1 | sed "s/^${key}: *//")"
        [[ -n "$value" ]] || value="unknown"
      fi
      echo "$value"
      ;;
    print)
      if [[ -f "$ENV_FILE" ]]; then
        while IFS=: read -r k v; do
          v="${v#"${v%%[![:space:]]*}"}"
          [[ -n "$k" ]] && echo "$k: $v"
        done < "$ENV_FILE"
      else
        echo "profile: unknown"
        echo "subagents: unknown"
        echo "vision: unknown"
        echo "terminal: unknown"
        echo "filesystem: unknown"
      fi
      ;;
    *)
      die "usage: devflow-ctl capabilities [get <key>]"
      ;;
  esac
}

# ── Knowledge base ────────────────────────────────────────────────────────────
# The knowledge base lives at docs/devflow/knowledge-base/learnings.md.
# Entries are ### headings under ## Cycle History.

KNOWLEDGE_FILE="${DEVFLOW_KNOWLEDGE_FILE:-docs/devflow/knowledge-base/learnings.md}"

cmd_knowledge() {
  case "${1:-}" in
    list)
      if [[ ! -f "$KNOWLEDGE_FILE" ]]; then
        echo "Knowledge base not found at $KNOWLEDGE_FILE"
        echo "Run '/devflow-templates bootstrap-knowledge' to create it from historical artifacts."
        exit 0
      fi
      local entries
      entries="$(grep -c '^### ' "$KNOWLEDGE_FILE" 2>/dev/null || true)"; entries="${entries:-0}"
      echo "Knowledge base: $KNOWLEDGE_FILE"
      echo "Entries: $entries"
      echo ""
      grep '^### ' "$KNOWLEDGE_FILE" 2>/dev/null || echo "(no entries yet)"
      ;;
    add)
      local entry_file="${2:-}"
      [[ -n "$entry_file" ]] || die "usage: devflow-ctl knowledge add <file>"
      [[ -f "$entry_file" ]] || die "knowledge add: file not found at $entry_file"
      # Ensure KB directory exists
      mkdir -p "$(dirname "$KNOWLEDGE_FILE")"
      # If KB doesn't exist, create it with the header
      if [[ ! -f "$KNOWLEDGE_FILE" ]]; then
        echo "# DevFlow Knowledge Base" > "$KNOWLEDGE_FILE"
        echo "" >> "$KNOWLEDGE_FILE"
        echo "## By Topic" >> "$KNOWLEDGE_FILE"
        echo "" >> "$KNOWLEDGE_FILE"
        echo "## Cycle History" >> "$KNOWLEDGE_FILE"
        echo "" >> "$KNOWLEDGE_FILE"
      fi
      # Append the entry file content to the KB
      echo "" >> "$KNOWLEDGE_FILE"
      cat "$entry_file" >> "$KNOWLEDGE_FILE"
      ok "knowledge entry from $entry_file appended to $KNOWLEDGE_FILE"
      ;;
    *)
      die "usage: devflow-ctl knowledge list | add <file>"
      ;;
  esac
}

# ── Deferred backlog ──────────────────────────────────────────────────────────
# The persistent record of scope-adjacent findings that fell outside the Core
# or Impact Zone of the cycle that found them (rules.md → Scope-Locking —
# Three Zones). Not session-scoped -- like the knowledge base, it survives
# across cycles at a fixed path, so this does not call resolve_session.

BACKLOG_FILE="${DEVFLOW_BACKLOG_FILE:-docs/devflow/backlog/deferred.md}"

cmd_backlog() {
  case "${1:-}" in
    add)
      local file="${2:-}" reason="${3:-}" severity="incomplete" i
      for ((i = 4; i <= $#; i++)); do
        if [[ "${!i}" == "--severity" ]]; then
          local j=$((i + 1))
          severity="${!j:-}"
        fi
      done
      [[ -n "$file" && -n "$reason" ]] || die 'usage: devflow-ctl backlog add <file> "<reason>" [--severity block|incomplete|info]'
      local sev_label
      case "$severity" in
        block)      sev_label="🔴 BLOCK" ;;
        incomplete) sev_label="🟠 INCOMPLETE" ;;
        info)       sev_label="🟢 INFO" ;;
        *) die "backlog add: --severity must be 'block', 'incomplete', or 'info'" ;;
      esac
      mkdir -p "$(dirname "$BACKLOG_FILE")"
      if [[ ! -f "$BACKLOG_FILE" ]]; then
        {
          echo "# Deferred Backlog"
          echo ""
          echo "Persistent record of scope-adjacent findings not fixed because they fell outside the Core or Impact Zone of the cycle that found them (rules.md → Scope-Locking — Three Zones). Read by the Brainstormer and Architect at the start of a cycle touching the same area, so what was skipped once doesn't stay skipped forever."
          echo ""
          echo "| ID | File | Reason | Severity | Cycle | Date | Status |"
          echo "|----|------|--------|----------|-------|------|--------|"
        } > "$BACKLOG_FILE"
      fi
      local n; n="$(grep -c '^| D[0-9]' "$BACKLOG_FILE" 2>/dev/null || true)"
      local id="D$((${n:-0} + 1))"
      # Pipes in free text would break the table -- neutralize them.
      file="${file//|/-}"; reason="${reason//|/-}"
      echo "| $id | $file | $reason | $sev_label | ${SLUG:-unknown} | $(now_iso) | open |" >> "$BACKLOG_FILE"
      ok "backlog entry $id recorded for '$file' ($severity)"
      ;;
    list)
      [[ -f "$BACKLOG_FILE" ]] || { echo "No deferred backlog found at $BACKLOG_FILE"; exit 0; }
      local area=""
      [[ "${2:-}" == "--area" ]] && area="${3:-}"
      if [[ -z "$area" ]]; then
        cat "$BACKLOG_FILE"
      else
        echo "| ID | File | Reason | Severity | Cycle | Date | Status |"
        echo "|----|------|--------|----------|-------|------|--------|"
        local line f
        while IFS= read -r line; do
          [[ "$line" == "| D"[0-9]* ]] || continue
          f="$(awk -F'|' '{gsub(/^ +| +$/,"",$3); print $3}' <<< "$line")"
          if _glob_match "$f" "$area"; then echo "$line"; fi
        done < "$BACKLOG_FILE"
      fi
      ;;
    *) die 'usage: devflow-ctl backlog add <file> "<reason>" [--severity block|incomplete|info] | list [--area <glob>]' ;;
  esac
}

# ── Metrics aggregation (deterministic) ───────────────────────────────────────
# Moves "recalculate the averages" from LLM arithmetic over a markdown table to
# a tool that actually adds. Only the 4 Averages rows with a real column behind
# them in Cycle History are computed; the other 2 (most frequent BLOCK
# category, phase with most retries) have no structured column to derive from
# and are left as an explicit manual note rather than silently faked.

AGGREGATE_FILE="${DEVFLOW_AGGREGATE_FILE:-docs/devflow/metrics/_aggregate.md}"

# Extracts "N" from the first line matching a label like "Tests created" or
# "BLOCK findings" (with or without a "(Reviewer)"/"(first run)" suffix),
# tolerating the two per-cycle metrics formats (full lifecycle vs standalone).
_metrics_field() {
  local file="$1" label="$2"
  grep -m1 -E "^\| ${label}" "$file" 2>/dev/null | grep -oP '\|\s*\K[0-9]+(?=\s*(/|\s*\(|\s*\|))' | head -1 || true
}

_metrics_aggregate() {
  local file="$1"
  local slug type date duration blocks tests test_pass_pct iterations

  slug="$(grep -m1 '^# DevFlow Metrics' "$file" | grep -oP '(?<=— )[a-zA-Z0-9-]+' | head -1 || true)"
  [[ -n "$slug" ]] || die "metrics aggregate: could not find slug in '# DevFlow Metrics — {slug}' header"
  type="$(grep -m1 '^# DevFlow Metrics' "$file" | grep -oP '(?<=standalone: )[a-zA-Z-]+(?=\))' || true)"
  type="${type:-full}"

  date="$(grep -m1 -E '^\*\*(Cycle started|Started):\*\*' "$file" | grep -oP '\d{4}-\d{2}-\d{2}' | head -1 || true)"
  date="${date:-unknown}"

  duration="$(grep -m1 -E '^\| \*\*TOTAL\*\*' "$file" | grep -oP '\|\s*\*\*\K[0-9]+(?=\*\*\s*\|\s*$)' || true)"
  duration="${duration:-—}"

  tests="$(_metrics_field "$file" 'Tests created')"; tests="${tests:-0}"
  blocks="$(_metrics_field "$file" 'BLOCK findings')"; blocks="${blocks:-0}"

  test_pass_pct="$(grep -m1 'Tests passing' "$file" | grep -oP '\(\K[0-9]+(?=%\))' || true)"
  test_pass_pct="${test_pass_pct:-—}"

  if grep -q '^## Iterations' "$file" 2>/dev/null; then
    iterations="$(awk '/^## Iterations/{f=1;next} /^## /{f=0} f' "$file" \
      | grep -oP '^\|[^|]*\|[^|]*\|\s*\K[0-9]+' | awk '{s+=$1} END{print s+0}' || true)"
  else
    iterations="$(_metrics_field "$file" 'Reviewer iterations')"; iterations="${iterations:-0}"
  fi
  iterations="${iterations:-0}"

  mkdir -p "$(dirname "$AGGREGATE_FILE")"
  if [[ ! -f "$AGGREGATE_FILE" ]]; then
    {
      echo "# DevFlow Aggregate Metrics"
      echo ""
      echo "> Updated: $(now_iso)"
      echo ""
      echo "## Cycle History"
      echo ""
      echo "| # | Date | Type | Feature | Duration | Tasks | BLOCKs | Test Pass % | Iterations |"
      echo "|---|------|------|---------|:--------:|:-----:|:------:|:----------:|:----------:|"
    } > "$AGGREGATE_FILE"
  fi

  local n; n="$(grep -c '^| [0-9]' "$AGGREGATE_FILE" 2>/dev/null || true)"
  local row_num=$(( ${n:-0} + 1 ))
  local test_pass_display="—"
  [[ "$test_pass_pct" != "—" ]] && test_pass_display="${test_pass_pct}%"
  local newrow="| $row_num | $date | $type | $slug | $duration | $tests | $blocks | $test_pass_display | $iterations |"

  # A plain `>>` only works the first time. On every run after the first, the
  # file already ends with a "## Averages" section -- appending blindly would
  # land the new row *after* it, where _metrics_recalculate_averages's own
  # truncate-and-rebuild step would discard it along with the stale section.
  # Insert the row immediately after the last existing data row instead (not
  # merely "before ## Averages" -- that would leave the blank line separating
  # the table from the next section in between the two rows, splitting the
  # markdown table in two).
  local last_row_line; last_row_line="$(grep -n '^| [0-9]\+ |' "$AGGREGATE_FILE" 2>/dev/null | tail -1 | cut -d: -f1 || true)"
  if [[ -n "$last_row_line" ]]; then
    sed -i "${last_row_line}a\\${newrow}" "$AGGREGATE_FILE"
  else
    echo "$newrow" >> "$AGGREGATE_FILE"
  fi

  _metrics_recalculate_averages
  ok "metrics from '$file' appended to $AGGREGATE_FILE (row #$row_num); averages recalculated"
}

# Recomputes the Averages section from the Cycle History table, replacing it
# in place. Only touches rows with a name this function knows how to compute;
# "Most frequent BLOCK category" and "Phase with most retries" have no source
# column and are preserved as manual entries (or left as a placeholder on the
# first run) rather than fabricated.
_metrics_recalculate_averages() {
  local total_cycles avg_duration avg_blocks avg_test_pass existing_category existing_phase

  total_cycles="$(grep -c '^| [0-9]' "$AGGREGATE_FILE" 2>/dev/null || true)"
  total_cycles="${total_cycles:-0}"

  avg_duration="$(LC_NUMERIC=C awk -F'|' '/^\| [0-9]/{gsub(/ /,"",$6); if ($6 ~ /^[0-9]+$/) {s+=$6; c++}} END{if (c>0) printf "%.1f", s/c; else print "—"}' "$AGGREGATE_FILE")"
  avg_blocks="$(LC_NUMERIC=C awk -F'|' '/^\| [0-9]/{gsub(/ /,"",$8); if ($8 ~ /^[0-9]+$/) {s+=$8; c++}} END{if (c>0) printf "%.1f", s/c; else print "0"}' "$AGGREGATE_FILE")"
  avg_test_pass="$(LC_NUMERIC=C awk -F'|' '/^\| [0-9]/{gsub(/[ %]/,"",$9); if ($9 ~ /^[0-9]+$/) {s+=$9; c++}} END{if (c>0) printf "%.0f", s/c; else print "—"}' "$AGGREGATE_FILE")"
  [[ "$avg_test_pass" != "—" ]] && avg_test_pass="${avg_test_pass}%"

  existing_category="$(awk -F'|' '/Most frequent BLOCK category/{gsub(/^ +| +$/,"",$3); print $3; exit}' "$AGGREGATE_FILE")"
  existing_category="${existing_category:-manual entry — no structured column to derive this from}"
  existing_phase="$(awk -F'|' '/Phase with most retries/{gsub(/^ +| +$/,"",$3); print $3; exit}' "$AGGREGATE_FILE")"
  existing_phase="${existing_phase:-manual entry — no structured column to derive this from}"

  # Strip any existing "## Averages" section (from the first "##" of that
  # heading to end of file) and append a freshly computed one.
  local tmp; tmp="$(mktemp)"
  awk '/^## Averages/{exit} {print}' "$AGGREGATE_FILE" > "$tmp"
  # Trim trailing blank lines left by the strip before re-appending.
  sed -i -e :a -e '/^\s*$/{$d;N;ba' -e '}' "$tmp" 2>/dev/null || true
  {
    cat "$tmp"
    echo ""
    echo ""
    echo "## Averages (last $total_cycles cycles)"
    echo ""
    echo "| Metric | Value |"
    echo "|--------|-------|"
    echo "| Avg. cycle duration | ${avg_duration} min |"
    echo "| Avg. BLOCKs per cycle | ${avg_blocks} |"
    echo "| Avg. test pass rate (first run) | ${avg_test_pass} |"
    echo "| Most frequent BLOCK category | ${existing_category} |"
    echo "| Phase with most retries | ${existing_phase} |"
    echo "| Total cycles completed | ${total_cycles} |"
  } > "$AGGREGATE_FILE"
  rm -f "$tmp"
}

cmd_metrics() {
  case "${1:-}" in
    aggregate)
      local metrics_file="${2:-}"
      [[ -n "$metrics_file" ]] || die "usage: devflow-ctl metrics aggregate <metrics-file>"
      [[ -f "$metrics_file" ]] || die "metrics aggregate: file not found at $metrics_file"
      _metrics_aggregate "$metrics_file"
      ;;
    *) die "usage: devflow-ctl metrics aggregate <metrics-file>" ;;
  esac
}

# ── Traceability coverage (deterministic) ────────────────────────────────────
# Moves "count the traceability rows and check they're all DONE" from LLM
# eyeballing to a tool that actually counts. Parses the Requirement -> Task ->
# Test -> Implementation table (traceability-matrix.md's format): rows are
# "| R<N> | {Source} | ... | {Status} |", Status is ⬜ PENDING / 🟡 IN PROGRESS
# / ✅ DONE.

_traceability_check() {
  local file="$1"
  local rows; rows="$(grep -E '^\| *R[0-9]+ *\|' "$file" 2>/dev/null || true)"
  if [[ -z "$rows" ]]; then
    fail "traceability check: no requirement rows found (expected '| R1 | ... |' rows in $file)"
    return 1
  fi

  # Per-Source and total counts (Source is field 3, Status is the last
  # non-empty field before the trailing "|") -- summarized deterministically
  # instead of eyeballed.
  local summary; summary="$(awk -F'|' '
    {
      src = $3; gsub(/^ +| +$/, "", src)
      status = $(NF-1); gsub(/^ +| +$/, "", status)
      total[src]++; grand_total++
      if (status ~ /DONE/) { done[src]++; grand_done++ }
    }
    END {
      for (s in total) printf "%s\t%d\t%d\n", s, done[s]+0, total[s]
      printf "TOTAL\t%d\t%d\n", grand_done+0, grand_total
    }
  ' <<< "$rows")"

  echo "Traceability Coverage — $file"
  echo ""
  printf "%-20s %8s %8s %6s\n" "Source" "Covered" "Total" "%"
  local src done_n total_n pct grand_done=0 grand_total=0
  while IFS=$'\t' read -r src done_n total_n; do
    [[ "$src" == "TOTAL" ]] && { grand_done="$done_n"; grand_total="$total_n"; continue; }
    pct=$(( total_n > 0 ? done_n * 100 / total_n : 0 ))
    printf "%-20s %8d %8d %5d%%\n" "$src" "$done_n" "$total_n" "$pct"
  done <<< "$summary"
  local grand_pct=$(( grand_total > 0 ? grand_done * 100 / grand_total : 0 ))
  printf "%-20s %8d %8d %5d%%\n" "TOTAL" "$grand_done" "$grand_total" "$grand_pct"
  echo ""

  if (( grand_pct < 100 )); then
    echo "Uncovered requirements:"
    awk -F'|' '{
      status = $(NF-1); gsub(/^ +| +$/, "", status)
      if (status !~ /DONE/) {
        id = $2; req = $4; gsub(/^ +| +$/, "", id); gsub(/^ +| +$/, "", req)
        print "  " id " — " req " (" status ")"
      }
    }' <<< "$rows"
    fail "traceability coverage is ${grand_pct}% — not 100%, see uncovered requirements above"
    return 1
  fi
  ok "traceability coverage is 100% (${grand_total}/${grand_total} requirements)"
}

cmd_traceability() {
  case "${1:-}" in
    check)
      local file="${2:-}"
      [[ -n "$file" ]] || die "usage: devflow-ctl traceability check <file>"
      [[ -f "$file" ]] || die "traceability check: file not found at $file"
      _traceability_check "$file"
      ;;
    *) die "usage: devflow-ctl traceability check <file>" ;;
  esac
}

# ── Sessions list ─────────────────────────────────────────────────────────────
# Lists all active DevFlow sessions with phase, mode, and lock state.

cmd_sessions() {
  if [[ ! -d "$SESSION_ROOT" ]]; then
    echo "No sessions found ($SESSION_ROOT does not exist)"
    exit 0
  fi
  local found=0
  while IFS= read -r -d '' statefile; do
    local slug phase mode lock locked_by rigor
    slug="$(basename "$(dirname "$statefile")")"
    # Read frontmatter fields without resolving a single session
    phase="$(awk '/^phase:/{print $2;exit}' "$statefile" 2>/dev/null || echo "?")"
    mode="$(awk '/^mode:/{print $2;exit}' "$statefile" 2>/dev/null || echo "?")"
    locked_by="$(awk '/^locked_by:/{sub(/^locked_by: */,"");print;exit}' "$statefile" 2>/dev/null || echo "?")"
    rigor="$(awk '/^rigor:/{print $2;exit}' "$statefile" 2>/dev/null || echo "?")"
    if [[ "$locked_by" == "none" || -z "$locked_by" ]]; then
      lock="unlocked"
    else
      lock="locked by $locked_by"
    fi
    printf "%-20s  Phase: %-6s  Mode: %-10s  Rigor: %-8s  %s\n" "$slug" "$phase" "$mode" "$rigor" "$lock"
    found=1
  done < <(find "$SESSION_ROOT" -mindepth 2 -maxdepth 2 -name phase-state.md -print0 2>/dev/null)
  if [[ $found -eq 0 ]]; then
    echo "No active sessions found"
  fi
}

# ── Clean stale sessions ──────────────────────────────────────────────────────
# Removes sessions that are unlocked or stale (locked >30 min without activity).

cmd_clean() {
  if [[ ! -d "$SESSION_ROOT" ]]; then
    echo "No sessions to clean ($SESSION_ROOT does not exist)"
    exit 0
  fi
  local force=false removed=0
  [[ "${1:-}" == "--force" ]] && force=true
  while IFS= read -r -d '' statefile; do
    local slug status locked_by locked_since epoch_now epoch_lock age
    slug="$(basename "$(dirname "$statefile")")"
    if $force; then
      rm -rf "$SESSION_ROOT/$slug"
      echo "  removed: $slug (--force)"
      ((removed++)) || true
      continue
    fi
    # A session explicitly marked cancelled (the Orchestrator's cancellation
    # path) is never auto-removed — the user may still want the artifacts.
    status="$(awk '/^status:/{sub(/^status: */,"");print;exit}' "$statefile" 2>/dev/null)"
    [[ "$status" == "cancelled" ]] && continue
    locked_by="$(awk '/^locked_by:/{sub(/^locked_by: */,"");print;exit}' "$statefile" 2>/dev/null || echo "none")"
    # Age is judged from locked_since regardless of lock state: `lock release`
    # stamps it with the release time, so an unlocked session must also sit
    # for STALE_LOCK_MINUTES before it is considered abandoned — a session
    # released seconds ago (mid-cycle handoff, or just finished) must survive.
    locked_since="$(awk '/^locked_since:/{sub(/^locked_since: */,"");print;exit}' "$statefile" 2>/dev/null)"
    epoch_now="$(date -u +%s)"
    epoch_lock="$(to_epoch "$locked_since")"
    [[ "$epoch_lock" != 0 ]] || continue  # no valid timestamp — leave it alone
    age=$(( (epoch_now - epoch_lock) / 60 ))
    if [[ $age -ge $STALE_LOCK_MINUTES ]]; then
      rm -rf "$SESSION_ROOT/$slug"
      if [[ "$locked_by" == "none" || -z "$locked_by" ]]; then
        echo "  removed: $slug (unlocked for ${age} min)"
      else
        echo "  removed: $slug (stale lock, ${age} min)"
      fi
      ((removed++)) || true
    fi
  done < <(find "$SESSION_ROOT" -mindepth 2 -maxdepth 2 -name phase-state.md -print0 2>/dev/null)
  if [[ $removed -eq 0 ]]; then
    ok "no stale sessions to clean"
  else
    ok "cleaned $removed session(s)"
  fi
}

# ── Security scanning (deterministic) ─────────────────────────────────────────
# Move vulnerability detection from "the LLM judges" to "a tool verifies". Each
# sub-scanner is best-effort: it runs a real scanner when present, falls back to
# a built-in detector where one exists, and skips gracefully (without failing)
# when neither applies — the same graceful-degradation contract as capabilities.
# The result is incontestable: the LLM's job shifts from FINDING vulnerabilities
# (unreliable) to FIXING the ones a tool deterministically reports.

SCAN_FINDINGS=0   # accumulated across sub-scanners in one invocation

# Files to scan: tracked text files in a git repo, else a filtered find.
_scan_files() {
  if [[ -d .git ]] && command -v git >/dev/null 2>&1; then
    git ls-files 2>/dev/null
  else
    find . -type f -not -path './.git/*' -not -path '*/node_modules/*' \
      -not -name '.devflow-environment' 2>/dev/null | sed 's|^\./||'
  fi
}

# Secrets: gitleaks if present, else a built-in high-signal regex detector.
scan_secrets() {
  echo "== scan: secrets =="
  if command -v gitleaks >/dev/null 2>&1; then
    if gitleaks detect --no-banner --redact -r /tmp/devflow-gitleaks.json >/dev/null 2>&1; then
      echo "  clean (gitleaks)"; return 0
    fi
    local n; n="$(jq 'length' /tmp/devflow-gitleaks.json 2>/dev/null || echo '?')"
    echo "  [HIGH] gitleaks reported $n potential secret(s) — see /tmp/devflow-gitleaks.json"
    SCAN_FINDINGS=$(( SCAN_FINDINGS + 1 )); return 1
  fi

  # Built-in fallback — high-signal, low-false-positive patterns.
  local -a rules=(
    "AWS access key|AKIA[0-9A-Z]{16}"
    "Private key block|-----BEGIN ([A-Z]+ )?PRIVATE KEY-----"
    "GitHub token|ghp_[A-Za-z0-9]{36}"
    "Slack token|xox[baprs]-[A-Za-z0-9-]{10,}"
    "Google API key|AIza[0-9A-Za-z_-]{35}"
    "Hardcoded secret assignment|(api[_-]?key|secret|token|passwd|password)['\"]?[[:space:]]*[:=][[:space:]]*['\"][A-Za-z0-9_-]{16,}['\"]"
  )
  local found=0 f rule name re lineno
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    for rule in "${rules[@]}"; do
      name="${rule%%|*}"; re="${rule#*|}"
      while IFS= read -r lineno; do
        [[ -n "$lineno" ]] || continue
        echo "  [HIGH] $f:$lineno — $name"
        found=$(( found + 1 ))
      done < <(grep -nIE -e "$re" "$f" 2>/dev/null | cut -d: -f1)
    done
  done < <(_scan_files)

  if (( found > 0 )); then
    SCAN_FINDINGS=$(( SCAN_FINDINGS + found ))
    echo "  $found potential secret(s) (built-in detector; install gitleaks for deeper coverage)"
    return 1
  fi
  echo "  clean (built-in detector; install gitleaks for deeper coverage)"
  return 0
}

# SCA: known CVEs in dependencies, language-agnostic.
#
# Each ecosystem detector below is independent and best-effort, following the
# same graceful-degradation contract as scan_secrets/scan_sast: if the manifest
# is present but the audit tool isn't installed, skip honestly (never fail the
# scan for a missing tool). All detected manifests run — a monorepo with both
# a Node frontend and a Python backend gets both audited, not just the first
# one found. `_sca_report <label> <crit> <high> <detail-hint>` is the shared
# accumulator so every ecosystem reports through one consistent path.
_SCA_ANY_MANIFEST=0

_sca_report() {
  local label="$1" crit="${2:-0}" hi="${3:-0}" hint="$4"
  crit="${crit:-0}"; hi="${hi:-0}"
  if (( crit + hi > 0 )); then
    echo "  [${crit} critical, ${hi} high] $label — $hint"
    SCAN_FINDINGS=$(( SCAN_FINDINGS + crit + hi )); return 1
  fi
  echo "  clean ($label, no high/critical vulnerabilities)"; return 0
}

_sca_node() {
  [[ -f package.json ]] || return 0
  _SCA_ANY_MANIFEST=1
  local tool
  if [[ -f pnpm-lock.yaml ]] && command -v pnpm >/dev/null 2>&1; then
    tool=pnpm
  elif [[ -f yarn.lock ]] && command -v yarn >/dev/null 2>&1; then
    tool=yarn
  elif command -v npm >/dev/null 2>&1; then
    tool=npm
  else
    echo "  skipped: package.json found but no npm/pnpm/yarn on PATH"; return 0
  fi
  local out crit hi
  case "$tool" in
    npm)
      out="$(npm audit --audit-level=high --json 2>/dev/null || true)"
      [[ -n "$out" ]] || { echo "  skipped: npm audit produced no output (offline or no lockfile)"; return 0; }
      crit="$(printf '%s' "$out" | jq -r '.metadata.vulnerabilities.critical // 0' 2>/dev/null || echo 0)"
      hi="$(printf '%s' "$out" | jq -r '.metadata.vulnerabilities.high // 0' 2>/dev/null || echo 0)"
      ;;
    pnpm)
      out="$(pnpm audit --audit-level high --json 2>/dev/null || true)"
      [[ -n "$out" ]] || { echo "  skipped: pnpm audit produced no output (offline or no lockfile)"; return 0; }
      crit="$(printf '%s' "$out" | jq -r '.metadata.vulnerabilities.critical // 0' 2>/dev/null || echo 0)"
      hi="$(printf '%s' "$out" | jq -r '.metadata.vulnerabilities.high // 0' 2>/dev/null || echo 0)"
      ;;
    yarn)
      # Classic `yarn audit` prints one JSON object per line (NDJSON); the
      # summary line carries the severity counts.
      out="$(yarn audit --json 2>/dev/null || true)"
      [[ -n "$out" ]] || { echo "  skipped: yarn audit produced no output (offline or no lockfile)"; return 0; }
      crit="$(printf '%s' "$out" | jq -rs '[.[] | select(.type=="auditSummary") | .data.vulnerabilities.critical] | add // 0' 2>/dev/null || echo 0)"
      hi="$(printf '%s' "$out" | jq -rs '[.[] | select(.type=="auditSummary") | .data.vulnerabilities.high] | add // 0' 2>/dev/null || echo 0)"
      ;;
  esac
  _sca_report "$tool dependencies" "$crit" "$hi" "run '$tool audit' for detail"
}

_sca_python() {
  { [[ -f requirements.txt ]] || [[ -f pyproject.toml ]] || [[ -f Pipfile ]]; } || return 0
  _SCA_ANY_MANIFEST=1
  if ! command -v pip-audit >/dev/null 2>&1; then
    echo "  skipped: Python manifest found but pip-audit not installed (pip install pip-audit)"; return 0
  fi
  local out crit hi
  out="$(pip-audit --format json 2>/dev/null || true)"
  [[ -n "$out" ]] || { echo "  skipped: pip-audit produced no output"; return 0; }
  # pip-audit has no built-in critical/high split -- every reported vuln
  # (dependencies[].vulns[]) is treated as "high" for the purposes of this
  # gate, since it has no CVSS severity field to bucket on.
  hi="$(printf '%s' "$out" | jq -r '[.dependencies[]?.vulns[]?] | length' 2>/dev/null || echo 0)"
  _sca_report "pip dependencies" 0 "$hi" "run 'pip-audit' for detail"
}

_sca_rust() {
  [[ -f Cargo.toml ]] || return 0
  _SCA_ANY_MANIFEST=1
  if ! command -v cargo-audit >/dev/null 2>&1 && ! cargo audit --version >/dev/null 2>&1; then
    echo "  skipped: Cargo.toml found but cargo-audit not installed (cargo install cargo-audit)"; return 0
  fi
  local out crit hi
  out="$(cargo audit --json 2>/dev/null || true)"
  [[ -n "$out" ]] || { echo "  skipped: cargo audit produced no output"; return 0; }
  crit=0
  hi="$(printf '%s' "$out" | jq -r '.vulnerabilities.count // 0' 2>/dev/null || echo 0)"
  _sca_report "cargo dependencies" "$crit" "$hi" "run 'cargo audit' for detail"
}

_sca_ruby() {
  [[ -f Gemfile ]] || return 0
  _SCA_ANY_MANIFEST=1
  if ! command -v bundle-audit >/dev/null 2>&1; then
    echo "  skipped: Gemfile found but bundle-audit not installed (gem install bundler-audit)"; return 0
  fi
  local out hi
  out="$(bundle-audit check --format json 2>/dev/null || true)"
  [[ -n "$out" ]] || { echo "  skipped: bundle-audit produced no output"; return 0; }
  hi="$(printf '%s' "$out" | jq -r '.results | length' 2>/dev/null || echo 0)"
  _sca_report "bundler dependencies" 0 "$hi" "run 'bundle-audit check' for detail"
}

_sca_go() {
  [[ -f go.mod ]] || return 0
  _SCA_ANY_MANIFEST=1
  if ! command -v govulncheck >/dev/null 2>&1; then
    echo "  skipped: go.mod found but govulncheck not installed (go install golang.org/x/vuln/cmd/govulncheck@latest)"; return 0
  fi
  local out hi
  out="$(govulncheck -json ./... 2>/dev/null || true)"
  [[ -n "$out" ]] || { echo "  skipped: govulncheck produced no output"; return 0; }
  # govulncheck streams one JSON object per line; count distinct OSV entries.
  hi="$(printf '%s' "$out" | jq -rs '[.[] | select(.osv != null) | .osv.id] | unique | length' 2>/dev/null || echo 0)"
  _sca_report "Go module dependencies" 0 "$hi" "run 'govulncheck ./...' for detail"
}

_sca_php() {
  [[ -f composer.json ]] || return 0
  _SCA_ANY_MANIFEST=1
  if ! command -v composer >/dev/null 2>&1; then
    echo "  skipped: composer.json found but composer not installed"; return 0
  fi
  # `composer audit` is built into Composer 2.4+ — no plugin required.
  local out hi
  out="$(composer audit --format=json --no-interaction 2>/dev/null || true)"
  [[ -n "$out" ]] || { echo "  skipped: composer audit produced no output (Composer < 2.4?)"; return 0; }
  hi="$(printf '%s' "$out" | jq -r '.advisories | [.[] | length] | add // 0' 2>/dev/null || echo 0)"
  _sca_report "Composer dependencies" 0 "$hi" "run 'composer audit' for detail"
}

_sca_dotnet() {
  { compgen -G "*.csproj" >/dev/null 2>&1 || compgen -G "*.sln" >/dev/null 2>&1; } || return 0
  _SCA_ANY_MANIFEST=1
  if ! command -v dotnet >/dev/null 2>&1; then
    echo "  skipped: .csproj/.sln found but dotnet SDK not installed"; return 0
  fi
  local out hi
  out="$(dotnet list package --vulnerable --format json 2>/dev/null || true)"
  if [[ -z "$out" ]]; then
    echo "  skipped: 'dotnet list package --vulnerable' produced no output (SDK < 8, or no restored packages)"; return 0
  fi
  hi="$(printf '%s' "$out" | jq -r '[.projects[]?.frameworks[]?.topLevelPackages[]?] | length' 2>/dev/null || echo 0)"
  _sca_report "NuGet dependencies" 0 "$hi" "run 'dotnet list package --vulnerable' for detail"
}

_sca_java() {
  { [[ -f pom.xml ]] || [[ -f build.gradle ]] || [[ -f build.gradle.kts ]]; } || return 0
  _SCA_ANY_MANIFEST=1
  echo "  skipped: Java/Kotlin manifest found — no zero-config CLI auditor available (configure the OWASP dependency-check Maven/Gradle plugin, or Snyk, in the project itself)"
}

scan_sca() {
  echo "== scan: dependencies (SCA) =="
  _SCA_ANY_MANIFEST=0
  local rc=0
  _sca_node   || rc=1
  _sca_python || rc=1
  _sca_rust   || rc=1
  _sca_ruby   || rc=1
  _sca_go     || rc=1
  _sca_php    || rc=1
  _sca_dotnet || rc=1
  _sca_java   || rc=1
  if (( _SCA_ANY_MANIFEST == 0 )); then
    echo "  skipped: no supported dependency manifest found (Node, Python, Rust, Ruby, Go, PHP, .NET, Java)"
    return 0
  fi
  return $rc
}

# SAST: dangerous code patterns (injection, unsafe sinks) via semgrep.
# No built-in regex fallback by design — a regex SAST produces false BLOCKs,
# the exact noise this deterministic approach exists to avoid. SAST needs a
# real engine, so without semgrep it skips and the gap is reported honestly.
scan_sast() {
  echo "== scan: code patterns (SAST) =="
  if command -v semgrep >/dev/null 2>&1; then
    local out n
    out="$(semgrep --config auto --json --quiet 2>/dev/null || true)"
    if [[ -z "$out" ]]; then
      echo "  skipped: semgrep produced no output (offline rule fetch?)"; return 0
    fi
    n="$(printf '%s' "$out" | jq '[.results[] | select(.extra.severity=="ERROR")] | length' 2>/dev/null || echo 0)"
    n="${n:-0}"
    if (( n > 0 )); then
      echo "  [$n ERROR-severity finding(s)] semgrep — run 'semgrep --config auto' for detail"
      SCAN_FINDINGS=$(( SCAN_FINDINGS + n )); return 1
    fi
    echo "  clean (no ERROR-severity semgrep findings)"; return 0
  fi
  echo "  skipped: semgrep not installed (install for SAST coverage: pipx install semgrep)"; return 0
}

cmd_scan() {
  local kind="${1:-all}"
  SCAN_FINDINGS=0
  case "$kind" in
    secrets)  scan_secrets || true ;;
    sca|deps) scan_sca || true ;;
    sast)     scan_sast || true ;;
    all)      scan_secrets || true; echo; scan_sca || true; echo; scan_sast || true ;;
    *) die "usage: devflow-ctl scan [secrets|sca|sast|all]" ;;
  esac
  echo
  if (( SCAN_FINDINGS > 0 )); then
    echo "[devflow-ctl] FAIL: scan found $SCAN_FINDINGS potential issue(s) — remediate before proceeding" >&2
    exit 1
  fi
  ok "scan: clean (no findings from the scanners that ran)"
}

# ── Doctor (diagnose install / session health) ────────────────────────────────
# One command to answer "why isn't this working?" — checks the environment
# marker, required tooling, scanner coverage, and every session's integrity,
# with an actionable fix per problem. Exit 1 if any hard failure, else 0.

DOC_FAILS=0
DOC_WARNS=0
_doc_ok()   { echo "  [ OK ] $*"; }
_doc_warn() { echo "  [WARN] $*"; DOC_WARNS=$(( DOC_WARNS + 1 )); }
_doc_fail() { echo "  [FAIL] $*"; DOC_FAILS=$(( DOC_FAILS + 1 )); }

cmd_doctor() {
  DOC_FAILS=0; DOC_WARNS=0
  echo "DevFlow Doctor"
  echo

  echo "Environment:"
  _detect_env_file
  if [[ -f "$ENV_FILE" ]]; then
    _doc_ok "environment marker present (profile: $(grep '^profile:' "$ENV_FILE" 2>/dev/null | sed 's/profile:[[:space:]]*//'))"
  else
    _doc_warn "no environment marker — run install.sh to enable capability detection"
  fi

  echo "Tooling:"
  if command -v git >/dev/null 2>&1; then _doc_ok "git available"; else _doc_warn "git not found — checkpoints/rollback unavailable"; fi
  if command -v jq  >/dev/null 2>&1; then _doc_ok "jq available";  else _doc_warn "jq not found — scan sca/sast parsing degraded"; fi
  local scanners=()
  command -v gitleaks >/dev/null 2>&1 && scanners+=("gitleaks")
  command -v semgrep  >/dev/null 2>&1 && scanners+=("semgrep")
  command -v npm      >/dev/null 2>&1 && scanners+=("npm-audit")
  if (( ${#scanners[@]} > 0 )); then
    _doc_ok "scanners: ${scanners[*]} (+ built-in secrets always on)"
  else
    _doc_warn "no external scanners — only the built-in secrets scan is active (install gitleaks/semgrep for deeper coverage)"
  fi

  echo "Sessions:"
  if [[ -d "$SESSION_ROOT" ]]; then
    local any=0 sf slug
    while IFS= read -r sf; do
      any=1
      slug="$(basename "$(dirname "$sf")")"
      if ! head -1 "$sf" | grep -q '^---$'; then
        _doc_fail "session '$slug': phase-state.md has no YAML frontmatter (corrupt or pre-1.0) — re-run 'devflow-ctl init'"
        continue
      fi
      local k missing=()
      for k in devflow slug mode phase; do
        grep -qE "^${k}:" "$sf" || missing+=("$k")
      done
      if (( ${#missing[@]} > 0 )); then
        _doc_fail "session '$slug': missing frontmatter key(s): ${missing[*]} — state is corrupt"
        continue
      fi
      local phase lb ls epoch age
      phase="$(grep -E '^phase:' "$sf" | head -1 | sed 's/phase:[[:space:]]*//')"
      lb="$(awk '/^locked_by:/{sub(/^locked_by:[[:space:]]*/,"");print;exit}' "$sf" 2>/dev/null)"
      ls="$(awk '/^locked_since:/{sub(/^locked_since:[[:space:]]*/,"");print;exit}' "$sf" 2>/dev/null)"
      if [[ -n "$lb" && "$lb" != "none" ]]; then
        epoch="$(to_epoch "$ls")"; age=$(( ($(date -u +%s) - epoch) / 60 ))
        if (( age >= STALE_LOCK_MINUTES )); then
          _doc_warn "session '$slug' (phase $phase): STALE lock by $lb (${age} min) — break with 'devflow-ctl lock acquire Orchestrator --force --slug $slug'"
        else
          _doc_ok "session '$slug': healthy (phase $phase, locked by $lb)"
        fi
      else
        _doc_ok "session '$slug': healthy (phase $phase)"
      fi
    done < <(find "$SESSION_ROOT" -mindepth 2 -maxdepth 2 -name phase-state.md 2>/dev/null)
    if (( any == 0 )); then _doc_ok "no active sessions"; fi
  else
    _doc_ok "no session directory yet ($SESSION_ROOT)"
  fi

  echo
  echo "Summary: $DOC_FAILS failure(s), $DOC_WARNS warning(s)"
  if (( DOC_FAILS > 0 )); then return 1; fi
  return 0
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-help}"; shift || true
case "$CMD" in
  init)       cmd_init "$@" ;;
  status)     cmd_status "$@" ;;
  phase)      cmd_phase "$@" ;;
  gate)       cmd_gate "$@" ;;
  scope)      cmd_scope "$@" ;;
  iterate)    cmd_iterate "$@" ;;
  lock)       cmd_lock "$@" ;;
  config)     cmd_config "$@" ;;
  checkpoint) cmd_checkpoint "$@" ;;
  artifacts)  cmd_artifacts "$@" ;;
  capabilities) cmd_capabilities "$@" ;;
  knowledge)  cmd_knowledge "$@" ;;
  backlog)    cmd_backlog "$@" ;;
  metrics)    cmd_metrics "$@" ;;
  traceability) cmd_traceability "$@" ;;
  sessions)   cmd_sessions "$@" ;;
  clean)      cmd_clean "$@" ;;
  scan)       cmd_scan "$@" ;;
  doctor)     cmd_doctor "$@" ;;
  version)    echo "devflow-ctl schema v$SCHEMA_VERSION" ;;
  help|--help|-h) sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$CMD' — run 'devflow-ctl help'" ;;
esac
